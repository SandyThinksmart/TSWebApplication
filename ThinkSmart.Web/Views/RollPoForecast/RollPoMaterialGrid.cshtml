@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<RollSalesForecastDetails>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;

}

<div>
    <table bgcolor="#7291D2" border="0" cellpadding="0" cellspacing="0" id="tblMaterialGrid" class="GridLines">

        <tr class="freez1">
            <th align="center" valign="middle" class="tdH1" colspan="13" style="padding:4px;">
                <label id="lblRollPOMaterialReport" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_RollPOMaterialReport")</label>

            </th>

        </tr>
        <tr class="freez2">
            <th align="left" valign="middle" rowspan="2" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMakerDetails" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Maker_Details")</label>

            </th>
            <th align="left" valign="middle" rowspan="2" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMatlNameMaker" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_MatlNameMaker")</label>

            </th>
            <th align="left" valign="middle" rowspan="2" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMaterialKubunL" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialKubun_L")</label>

            </th>
            <th align="left" valign="middle" colspan="4" class="tdHeaderClass labelClass GridCenter">
                <label id="lblDimD" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</label>

            </th>
            <th align="left" valign="middle" rowspan="2" class="tdHeaderClass labelClass GridCenter">
                <label id="lblLength" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Length")</label>

            </th>
            <th align="left" valign="middle" colspan="4" class="tdHeaderClass labelClass GridCenter">
                <label id="lblEstimated_Amount" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Estimated_Amount")</label>

            </th>
            <th align="left" valign="middle" rowspan="2" class="tdHeaderClass labelClass GridCenter">
                <label id="lbl_Investigation_End" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Investigation_End")</label>

            </th>
            
        </tr>
        <tr class="freez3">
           @*  <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMakerName" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_MakerName")</label>

            </th> *@
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter"> 
                <label id="lblDiameter" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Diameter")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblShape" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Shape")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblWidth" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Width")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblAuxiliary" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_AuxiliaryOther")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMaterilGridLastRoll1" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")</label><br />
                (<label id="lblMaterilGridRollForMonth1" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")</label>)
            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMaterilGridLastRoll2" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")</label><br />
                (<label id="lblMaterilGridRollForMonth2" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")</label>)
            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMaterilGridLastRoll3" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")</label><br />
                (<label id="lblMaterilGridRollForMonth3" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")</label>)
            </th>
            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                <label id="lblMaterilGridLastRoll4" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_XXRoll")</label><br />
                (<label id="lblMaterilGridRollForMonth4" class="labelClass" data-template="@LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_MMMonth")</label>)
            </th>
        </tr>
        <tr class="freez4">
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter">
                <label id="lblMakerMaster" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_MakerMaster")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter">
                <label id="lblInternal" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Internal")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter">
                <label id="lblGeneralSpecialL" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_GeneralSpecial_L")</label>

            </th>
            
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter" colspan="4">
                <label id="lblCondition" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Condition")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter">
                <label id="lblDirectDeliveryLocation" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_DirectLocation")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter" colspan="4">
                <label id="lblRemark" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Remark")</label>

            </th>
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter">
                <label id="lblMaterialReply" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Material_Reply")</label>

            </th>
            
        </tr>
        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
       <tr class="GridNormalRow">

            <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
            <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap">@item.MATL_MAKER_NAME</td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap">@item.MATERIAL_KUBUN_STRING</td>
            <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.MATL_DIM_D</td>
            <td   class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.MATL_SHAPE</td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.MATL_DIM_W</td>
            <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"> </td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.MATERIAL_LENGTH</td>
            <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.FC_QTY_R1</td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.FC_QTY_R2</td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.FC_QTY_R3</td>
            <td  class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap">@item.FC_QTY_R4</td>
            <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"><input type="checkbox" @(item.SALES_FC_DONE ? "checked" : "") onclick="return false;" /></td>
            
        </tr>
       

        <tr class="GridNormalRow">
           <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.MAKER_NAME</td>
           <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap">@item.INTERNAL_NAME_STRING</td>
           <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.MATL_SPECIAL_KUBUN</td>
           <td colspan="4" class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.CONDITION_DESCRIPTION</td>
           <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap">@item.MOCHIKOMISAKI_NAME</td>
           <td colspan="4" class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.REMARKS</td>
           <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap">@item.REPLY_FROM_MATL_DEPT</td>
 
        </tr>
        }
        }
        else
        {
            <tr class="GridNormalRow">

                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"> </td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:right; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>

            </tr>

            <tr class="GridNormalRow">
                <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>
                <td colspan="4" class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
                <td colspan="4" class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>
                <td class="labelClass padddingLeft padddingRight" style="text-align:left; white-space:nowrap"></td>

            </tr>
        }
    </table>

</div>
@section Scripts{

    <link href="~/css/Common.css" rel="stylesheet" />
    <link href="~/css/RollPoForecast.css" rel="stylesheet" />
    <link href="~/css/Common_Styles.css" rel="stylesheet" />
    <link href="~/css/masterStyles.css" rel="stylesheet" />


}  