                                                @{
                                                    var data = Tuple.Create("txtCustomer", "btnCustomerSearch", "ddlCustomerName","",3);
                                                    @Html.Partial("~/Views/SearchComboCustomer/SearchComboCustomer.cshtml", data)

                                                }
                                            </div>
