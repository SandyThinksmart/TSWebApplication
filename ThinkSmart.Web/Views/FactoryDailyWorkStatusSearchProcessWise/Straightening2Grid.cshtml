@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<Straightening2Details>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;

}
<style>
    .freezStraighteing2DailyGrid > th {
        position: sticky !important;
        background-color: #4e6cab;
        top: 0.0px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezStraighteing2DailyGrid {
        border-color: white;
    }

        .freezStraighteing2DailyGrid1 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 20px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezStraighteing2DailyGrid1 {
        border-color: white;
    }

    .freezStraighteing2DailyGrid2 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 40px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezStraighteing2DailyGrid2 {
        border-color: white;
    }

    
</style>
<table class="GridLinesTable GridLayout GridColumnLeftPadding" cellpadding="0" cellspacing="0" border="1" id="tblTbPMSCorrectionDailyReport2" >
