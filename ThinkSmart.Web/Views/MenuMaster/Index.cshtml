   <script>
function toggleRows(parentId, iconElement) {

    const rows = document.querySelectorAll(
        'tr[data-parent="' + parentId + '"]'
    );

    const expand = [...rows].every(row =>
        row.classList.contains('hidden')
    );

    rows.forEach(row => {

        if (expand) {
            row.classList.remove('hidden');
        } else {
            hideRecursive(row);
        }
    });

    if (iconElement) {
        iconElement.textContent = expand ? '−' : '+';
    }
}

function hideRecursive(row) {

    row.classList.add('hidden');

    const childId = row.dataset.id;

    if (childId) {

        const icon = row.querySelector('.icon');
        if (icon) icon.textContent = '+';

        document
            .querySelectorAll('tr[data-parent="' + childId + '"]')
            .forEach(hideRecursive);
    }
}

document.querySelectorAll('.menu, .sub').forEach(row => {

    row.addEventListener('click', function () {

        toggleRows(
            this.dataset.id,
            this.querySelector('.icon')
        );
    });
});
</script>
}
