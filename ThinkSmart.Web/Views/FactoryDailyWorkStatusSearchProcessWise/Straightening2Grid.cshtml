                    <td class="labelClass padddingRight tdNoWrap Proceplanwidth1 NumericFieldsClass" style="text-align:right">@item.STR_DIM_AFTER_X_1_STRING</td>
                    <td class="labelClass padddingRight tdNoWrap Proceplanwidth1 NumericFieldsClass" style="text-align:right">@item.STR_DIM_AFTER_X_2_STRING</td>
                    <td class="labelClass padddingRight tdNoWrap Proceplanwidth1 NumericFieldsClass" style="text-align:right">@item.STR_DIM_AFTER_X_3_STRING</td>
