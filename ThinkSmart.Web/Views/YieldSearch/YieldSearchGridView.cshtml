                        <td class="labelClass GridLeft">@item.PP_MATL_SHAPE</td> *@
                       
                        
                       @*  <td class="labelClass GridCenter">@item.PP_PROD_SPEC_NO</td>
                        <td class="labelClass GridCenter">@item.PROCESS_PLAN_CMPL_DATE_STRING</td>
                        <td class="labelClass GridCenter">@item.PROCESS_PLAN_CMPL_DATE_STRING</td> *@
