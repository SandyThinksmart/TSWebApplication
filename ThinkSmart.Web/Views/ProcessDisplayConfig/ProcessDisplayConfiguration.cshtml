@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@using TSWebApplication.Domain.Model
@model List<ProcessDisplayConfigDetails>

@{
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lblMenu_ProcessDisplayOrder").Value.Replace("</br>", "");
   
}
<link href="~/css/Common.css" rel="stylesheet" />
<link href="~/css/processdisplayconfiguration.css" rel="stylesheet" />
<link href="~/css/Common_Styles.css" rel="stylesheet" />
<link href="~/css/masterStyles.css" rel="stylesheet" />

<br />
<br />
<div>
    <div id="tblmsgTitle">
        <label class="labelClass centerAlign">@LocalizationServices.GetLocalizedHtmlString("title_ProcessDisplayOrder")</label>
    </div>
    <table>
        <tr>
            <td>
                <table id="tblBasicOperation" style="margin-left: 5px;">
                    <tr>
                        <td class="tdCenter" colspan="2">
                            <label ID="" class="labelClass labelcolor">@LocalizationServices.GetLocalizedHtmlString("lbl_BasicOperations")</label><br />
                        </td>
                    </tr>
                    <tr class="tdCenter">
                        <td id="">
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="btnInitialize" class="_functionButtons" CausesValidation="false" />
                        </td>
                        <td>
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Register")" ID="btnRegister" class="_functionButtons" CausesValidation="false" />
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width: 97px"></td>
            <td>
                <table id="DivCloseButton" style="width: 95px; height: 60px;">
                    <tr>
                        <td id="pnlButtonSectionlabel">
                            <label ID="Label5" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                        </td>
                    </tr>
                    <tr>
                        <td id="pnlButtonSectionButton">
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose" class="_functionButtons" CausesValidation="false" />
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table> <br />

    <table id="tblBody">

        <tr>
            <td>
                <br />
                <label ID="lblProcess" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Process_L")</label>

                <select id="ddlProcess" class="MandatoryDropdown Mandatory DropdownListClass labelClass" onchange="getProcessVal(this);" style="width: 212px;"
                    errorlabel="@LocalizationServices.GetLocalizedHtmlString("valMsg_ProcessRequired")">
                </select>
            </td>
        </tr>
    </table>
    <table id="tblGrid">
        <tr>
            <td>
                <br />
                <label ID="lblProcessListForOrder" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessListForOrder")</label>
            </td>
        </tr>

        <tr>
            <td>
                <div id="ProcessDisplayConfigGrid">
                    @{
                        @await Html.PartialAsync("DisplayProcessGridView", Model)
                        ;
                    }
                </div>
            </td>
        </tr>
    </table>

</div>
<div id="divErrorMessages" class="Hidden">
    <label id="lblErrorMessageE_ProcessDisplayConfig001" class="Hidden">
        <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
    </label>

    <label id="lblErrorMessageE_ProcessDisplayConfig002" class="Hidden">
        <span ID="LiteralPriorityIsRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_PriorityIsRequired")</span>
    </label>
    <label id="lblErrorMessageE_ProcessDisplayConfig003" class="Hidden">
        <span ID="LiteralAtListOneShowCheckBoxRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_AtListOneShowCheckBoxIsRequired")</span>
    </label>
    <label id="lblErrorMessageE_ProcessDisplayConfig004" class="Hidden">
        <span ID="LiteralAtListOneShowCheckBoxRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_DuplicateOrderNotAllowed")</span>
    </label>
</div>
<div id="divSuccessMessages" class="Hidden">
    <label id="lblSuccessMessageS_ProcessDisplayConfig_001" class="Hidden">
        <span ID="LiteralDataSavedSuccessfully">@LocalizationServices.GetLocalizedHtmlString("successMsg_COM_DataSaved")</span>
    </label>
</div>

@section Scripts{
    <script src="~/static/js/ProcessDisplayConfiguration.js"></script>
}