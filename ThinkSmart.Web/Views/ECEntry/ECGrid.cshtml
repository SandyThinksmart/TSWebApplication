@using TSWebApplication.Domain.Model
@model List<ECDetails>
@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@{
    Layout = null;
}


<table class="GridLines GridColumnLeftPadding" cellpadding="0" cellspacing="0" border="1">
    <thead>
        <tr class="GridHeader GridViewScrollHeader freez GridHeaderPadding" id="grdvECDetails" style="border-collapse:collapse;text-align: left">
            <th class="tdHeaderClass labelClass sticky-header" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("")</th>
            @*<th></th>*@
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_TabaNo")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Machine_L")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_OperationDay")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</th>
            @*<th></th>*@
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProductDim")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdShape")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProductLength")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_MatlNameMaker")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialDimD")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Charge")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_MetallicLabel")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Operator")</th>
            <th class="tdHeaderClass labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Decision")</th>

        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)

        {
            @foreach (var item in Model)
            {
                <tr data-lblECCD="@item.EC_CD">
                    <td class="sticky-col1">
                        <input id="btnlnkedit" type="button" value='@LocalizationServices.GetLocalizedHtmlString("lbl_EditDelete")' class="_functionButtons"
                        onclick="GetECDetailsByECCD($(this))" />
                    </td>
                    @*<td class="labelclass">@item.dw_drawing_cd</td>*@
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:center; white-space:nowrap">@item.PP_CHUUBAN_GYOBAN</td>
                    @*<td class="labelclass">@item.PP_PROD_SPEC_NO</td>*@
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:center; white-space:nowrap">@item.EC_TABA_NO</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.EC_MACHINE_NAME</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:center; white-space:nowrap">@item.EC_START_DATE_STRING</td>
                    @*<td class="labelclass">@item.EC_START_OPERATOR_NAME</td>*@
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.PP_CUSTOMER_NAME</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.PP_PROD_NAME_CUST</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:right; white-space:nowrap">@item.PP_PROD_DIMD_SHAPE</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.PP_PROD_SHAPE</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:right; white-space:nowrap">@item.PP_PROD_LENGTH_OTHER</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.PP_MATL_NAME_MAK</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:right; white-space:nowrap">@item.PP_MATL_DIM_D_STRING</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.PP_CHARGE</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.EC_METALLIC_PLATE_CODE</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:right; white-space:nowrap">@item.EC_OK_BARS_STRING</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:right; white-space:nowrap">@item.EC_OK_QTY</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.EC_START_OPERATOR_NAME</td>
                    <td class="labelclass tdPaddingLeftandRight" style="text-align:left; white-space:nowrap">@item.EC_DECISION_STRING</td>
                </tr>
            }

        }
        else
        {
            <tr style="height:20px;"><td colspan="18" align="left" style="padding-left:5px;"><label ID="lbldatanotavailable" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_NoRecordFound_L")</label></td></tr>
        }
       
    </tbody>
</table>
