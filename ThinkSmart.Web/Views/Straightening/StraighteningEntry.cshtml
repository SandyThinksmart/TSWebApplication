<script>
        window.onload = function() {
            
            //document.getElementById('tdLblChuuban').style.display = 'none';   
            //document.getElementById('tdtxtNifudaNo1').style.display = 'none';   

            document.getElementById('dvMessage').style.display = 'none'; 
            //document.getElementById('txtHostRefNoT4').style.display = 'none'; 
            //document.getElementById('lblHostRefNoT4').style.display = 'none'; 

          document.getElementById('lblReductionUnit0').style.display = 'inline';
          document.getElementById('lbl_mm').style.display = 'inline';
         document.getElementById('txtNifudaNo1').style.backgroundColor = '#C1FFFF';
        $('#txtNifudaNo1')
            .attr('autocomplete', 'off')
            .attr('inputmode', 'latin')
            .attr('autocorrect', 'off')
            .attr('autocapitalize', 'off')
            .attr('spellcheck', false);

        // Block Japanese IME input
        $('#txtNifudaNo1').on('compositionstart compositionupdate', function (e) {
            e.preventDefault();
        });

        // Convert and keep only half-width English
        $('#txtNifudaNo1').on('compositionend input', function () {

            let value = this.value;

            // Full-width → Half-width
            value = value.replace(/[！-～]/g, function (ch) {
                return String.fromCharCode(ch.charCodeAt(0) - 0xFEE0);
            });

            // Remove non-English
            value = value.replace(/[^A-Za-z0-9]/g, '');

            // Uppercase
            value = value.toUpperCase();

            this.value = value;
        });
        };
        
    </script>
