@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<StamppingDetails>
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lblMenu_StampingProcessEditDelete").Value.Replace("</br>", ""); ;
    Layout = "~/Views/Shared/_LayoutProcessEditDeleteTemplate.cshtml";
    
}
<link href="~/css/StamppingEditDelete.css" rel="stylesheet" asp-append-version="true" />
<meta name="google" content="notranslate" />

<style type="text/css">
    .hide {
        display: none;
    }

    .headerPadding {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .fixLengthDataPadding {
        padding-left: 5px !important;
        padding-right: 5px !important;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        border-color: white;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }
</style>





<tsSortPopUp:SortPopup ID="tsSortPopup" OnSortOKClick="tsSortPopup_OKClick" />
