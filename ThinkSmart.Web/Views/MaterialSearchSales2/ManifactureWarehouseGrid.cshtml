@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@{
    Layout = null;

}

<link href="~/css/common_styles.css" rel="stylesheet" />
<link href="~/css/common.css" rel="stylesheet" />


<div style="overflow: auto;height: 500px;width:396px;border: solid;border-color: gray;border-width: thin;">
<table bgcolor="#7291D2" border="0" cellpadding="0" cellspacing="0" id="tblMaterialMakerGrid">

    <tr>
        <td colspan="12" align="center" valign="middle" class="tdH1">
            <label ID="lbl_MakerMaterialInfo"
               class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_ManifactureWarehouseReceipt")</label>
        </td>
    </tr>

    <tr class="trTdH2">
        <th id="tdMaterialNameMaker" class="tdHeaderClass labelClass GridCenter">
                <label ID="lbl_MaterialNameMaker" class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_NyukoDate")</label>
        </th>
        <th id="tdDimD" class="tdHeaderClass labelClass GridCenter">
                <label ID="lblDimDSearch" class="labelClass1" ForeColor="Black">@LocalizationServices.GetLocalizedHtmlString("lbl_NyukoLocation")</label>
        </th>
        <th id="tdShape" class="tdHeaderClass labelClass GridCenter">
                <label ID="lblShapeSearch" class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_NyukoQuantity1")</label>
        </th>
        <th id="tdLength" class="tdHeaderClass labelClass GridCenter">
                <label ID="lblLengthSearch" class="labelClass ">@LocalizationServices.GetLocalizedHtmlString("lbl_Charge")</label>
        </th>
        <th id="tdCondition" class="tdHeaderClass labelClass GridCenter">
                <label ID="lblCondition" class="labelClass1 ">@LocalizationServices.GetLocalizedHtmlString("lbl_Remark")</label>
        </th>
    </tr>

    <tr class="GridNormalRow">
        <td class="labelClass td tdSearchGrid padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
        <td class="labelClass td tdSearchGrid padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
        <td class="labelClass td tdSearchGrid padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
        <td class="labelClass td tdSearchGrid padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
        <td class="labelClass td tdSearchGrid padddingLeft padddingRight" style="text-align:center; white-space:nowrap"></td>
    </tr>
</table>
</div>