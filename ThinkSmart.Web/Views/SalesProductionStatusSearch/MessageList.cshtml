@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@using TSWebApplication.Domain.Model
@model List<ProcessPlanForSalesProductionStatusDetails>

@{
    ViewData["Title"] = "製造工程進捗状況問合せ_SalesProductionStatusSearch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/css/Common.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/Common_Styles.css" rel="stylesheet" asp-append-version="true" />

<link href="~/css/masterStyles.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/salesproductionstatussearch.css" rel="stylesheet" asp-append-version="true" />

<br />
<br />
<div>
    <table id="tblmsgTitle" style="width:98%">
        <tr>
            <td>
                <label class="labelClass lblMsgTitle">@LocalizationServices.GetLocalizedHtmlString("title_Message_List")</label>
            </td>
        </tr>
    </table><br /><br />

    <table id="tblBody">
        <tr>
            <td>
                <table style="width:569px">
                    <tr>

                        <td style="width: 50px;">
                            <label ID="lblMessageDateTime" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_MessageDateT3")</label>
                        </td>

                        <td style="width: 135px;">
                            <input type="text" ID="txtMessageDateTime" class="form-control Mandatory textboxheight MandatoryTextBox InActiveIMEMode"
                                   TabIndex="1" style="Width:121px" errorLabel="@LocalizationServices.GetLocalizedHtmlString("valMsg_MessageDateTimeRequired")" ><span class="text-danger" ></span>
                        </td>
                    </tr>
                    <tr>
                        <td style="width:60px" align="left">
                            <label ID="lblSalesIncharge" class="labelClass labelPadding tdNoWrap">
                                @LocalizationServices.GetLocalizedHtmlString("lbl_Oprator")
                            </label>
                        </td>
                        <td colspan="1" align="left">
                            <input type="text" class="labelClass" style="width:60px" id="txtYobinaOperatorSearch" tabindex="7" maxlength="15" />
                            <input type="button" value="-" id="btnYobinaOpeartorSearch" tabindex="8" />
                            <select ID="ddlSalesInchargeValue" TabIndex="9" class="MandatoryDropdown Mandatory" errorLabel="@LocalizationServices.GetLocalizedHtmlString("valMsg_MessageSenderRequired")">
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label ID="lblDeliveryRemark" class="labelClass labelPadding tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DeliveryRemarks")</label>
                        </td>
                        <td>
                            <input type="text" ID="txtDeliveryRemark" class="Mandatory" style="width:250px" errorLabel="@LocalizationServices.GetLocalizedHtmlString("valMsg_MessageDetailsRequired")" >
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
      
    </table>
    <br />
    <div id="divMessageListGridMain">
        @{
            @await Html.PartialAsync("MessageListGridView", Model)
            ;
        }
    </div>
    <table style="width:98%">
        <tr>
            <td>
                <table id="tblBasicOperation" style="margin-left: 5px;">
                    <tr>
                        <td class="tdCenter" colspan="4">
                            <label ID="" class="labelClass labelcolor">@LocalizationServices.GetLocalizedHtmlString("lbl_BasicOperations")</label><br />
                        </td>
                    </tr>
                    <tr class="tdCenter">
                        <td id="">
                            <input type="button" style="margin:2px" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="BtnInitialize" class="_functionButtons" CausesValidation="false" />
                        </td>
                        <td>
                            <input type="button" style="margin:2px" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Register")" ID="BtnRegister" class="_functionButtons" CausesValidation="false" />
                        </td>
                        <td>
                            <input type="button" style="margin:2px" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Edit")" ID="BtnEdit" class="_functionButtons" CausesValidation="false" />
                        </td>
                        <td>
                            <input type="button" style="margin:2px" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Delete")" ID="BtnDelete" class="_functionButtons" CausesValidation="false" />
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width: 291px"></td>
            <td>
                <table id="DivCloseButton" style="width: 95px; height: 60px;">
                    <tr>
                        <td id="pnlButtonSectionlabel">
                            <label ID="Label5" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                        </td>
                    </tr>
                    <tr>
                        <td id="pnlButtonSectionButton">
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose" class="_functionButtons" CausesValidation="false" />
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>
<div id="divErrorMessages" class="Hidden">
    <label id="lblErrorMessageE_SalesProcessMessage_001" class="Hidden">
        <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
    </label>
    <label id="lblErrorMessageE_SalesProcessCanNotEditdelete_002" class="Hidden">
        <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_MsgRegistrationCanNotEditDelete")</span>
    </label>
</div>
<div id="divSuccessMessages" class="Hidden">
    <label id="lblSuccessMessageS_SalesProcessMessage_001" class="Hidden">
        <span ID="LiteralDataSavedSuccessfully">@LocalizationServices.GetLocalizedHtmlString("successMsg_COM_DataSaved")</span>
    </label>
</div>
<div>
    <input type="hidden" class="hidden" id="hdfProcessPlanCd" value="" />
    <input type="hidden" class="hidden" id="hdnMsgCd" value="" />
</div>

@section Scripts {
    <script src="~/static/js/SalesProcessMessage.js" asp-append-version="true"></script>
}
