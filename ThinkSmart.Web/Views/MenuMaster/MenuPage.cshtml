    <script type="text/javascript">
        $(document).ready(function () {
            $('#divMaster').show();
            $('#divFactoryOfc').hide();
            $('#divFactoryWorkshop').hide();
            $('#divHandyTerminal').hide();
              $('#divCSVList1').hide();
            
            $('#lnkMaster').click(function () {
                $('#divMaster').show();
                $('#divFactoryOfc').hide();
                $('#divFactoryWorkshop').hide();
                $('#divHandyTerminal').hide();
                $('#divCSVList1').hide();
                $('#trCSVList1').addClass("hidden");
            });
            $('#lnkFactoryOfc').click(function () {
                $('#divFactoryOfc').show();
                $('#divFactoryWorkshop').hide();
                $('#divHandyTerminal').hide();
                $('#divMaster').hide();
                $('#divCSVList1').hide();
                $('#trCSVList1').addClass("hidden");
            });
            $('#lnkFactoryWorkshop').click(function () {

                $('#divFactoryWorkshop').show();
                $('#divMaster').hide();
                $('#divFactoryOfc').hide();
                $('#divHandyTerminal').hide();
                $('#divCSVList1').hide();
                $('#trCSVList1').addClass("hidden");
            });
            $('#lnkHandyTerminal').click(function () {
                $('#divHandyTerminal').show();
                $('#divFactoryOfc').hide();
                $('#divFactoryWorkshop').hide();
                $('#divMaster').hide();
                $('#divCSVList1').hide();
                $('#trCSVList1').addClass("hidden");
            });
             $('#lnkCSVList1').click(function () {
                $('#divHandyTerminal').hide();
                $('#divFactoryOfc').hide();
                $('#divFactoryWorkshop').hide();
                $('#divMaster').hide();
                $('#divCSVList1').show();
            });


        });

    </script>
    <script>
        function toggleRows(parentId, iconElement) {

            const rows = document.querySelectorAll(
                'tr[data-parent="' + parentId + '"]'
            );

            const expand = [...rows].every(row =>
                row.classList.contains('hidden')
            );

            rows.forEach(row => {

                if (expand) {
                    row.classList.remove('hidden');
                } else {
                    hideRecursive(row);
                }
            });

            if (iconElement) {
                iconElement.textContent = expand ? '−' : '+';
            }
        }

        function hideRecursive(row) {

            row.classList.add('hidden');

            const childId = row.dataset.id;

            if (childId) {

                const icon = row.querySelector('.icon');
                if (icon) icon.textContent = '+';

                document
                    .querySelectorAll('tr[data-parent="' + childId + '"]')
                    .forEach(hideRecursive);
            }
        }

        document.querySelectorAll('.menucsv, .sub').forEach(row => {

            row.addEventListener('click', function () {

                toggleRows(
                    this.dataset.id,
                    this.querySelector('.icon')
                );
            });
        });
    </script>
}
