                                </td>
                            </tr>
                        </table>

                    </td>

                    <td style="height:70px; width:148px">
                        <table bgcolor="Navy" border="0" cellpadding="0" cellspacing="0" frame="border" style=" width: 100%; height: 100%;">
                            <tr>
                                <td align="center" valign="bottom">
                                    <label ID="lblClose" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                                </td>
                            </tr>
                            <tr>
                                <td align="center">
                                    <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose" class="_functionButtons" OnClientClick="return Confirmation()" TabIndex="4"
                                           style="width:90px" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

            </table>

        </td>

    </tr>

</table>

