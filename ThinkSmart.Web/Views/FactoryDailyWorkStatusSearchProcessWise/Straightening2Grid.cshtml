            <th id="strng2MetallicLabelNo" class="headerPadding labelClass tdNoWrap Proceplanwidth1">@LocalizationServices.GetLocalizedHtmlString("lbl_ActAllocQty1")</th>
            <th id="strng2Max" class="headerPadding labelClass tdNoWrap ">@LocalizationServices.GetLocalizedHtmlString("lbl_MAX")</th>
            <th id="strng2Min" class="headerPadding labelClass tdNoWrap ">@LocalizationServices.GetLocalizedHtmlString("lbl_MIN")</th>
            <th id="" colspan="4" class="headerPadding labelClass tdNoWrap Proceplanwidth1">@LocalizationServices.GetLocalizedHtmlString("lbl_ActDiamension")</th>

            <th id="strng2WeightWithoutKG" class="headerPadding labelClass tdNoWrap Proceplanwidth1">@LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")</th>
            <th id="strng2BendStatus" class="headerPadding labelClass tdNoWrap Proceplanwidth1">@LocalizationServices.GetLocalizedHtmlString("lbl_BendStatus")</th>

            <label id="strng2DimBeforeMAX" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DimBeforeMAX")</label>
            <label id="strng2DimBeforeMIN" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DimBeforeMIN")</label>

            <label id="strng2DimAfter1" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DimAfter1")</label>
            <label id="strng2DimAfter2" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DimAfter2")</label>
            <label id="strng2DimAfter3" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DimAfter3")</label>
            <label id="strng2ActDim1" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_ActDim1")</label>
            <label id="strng2ActDim2" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_ActDim2")</label>
            <label id="strng2ActDim3" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_ActDim3")</label>

        </tr>



    </thead>
    <tbody>
        @if (Model != null && Model.Count > 0)

            {
                foreach (var item in Model)
                {
                <tr class="GridNormalRow" data-lblProcessPlanCD="@item.PP_PROCESS_PLAN_CD">
                    <td rowspan="2" class="sticky-col1">
                        <input type="button" id="" ID="lnkEdit" class="btnArrow" onclick="OnEditClick($(this))" style="height:42px" CausesValidation="false" />
                    </td>
                    <td class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_LOCATION_NAME</td>
                    <td class="labelClass centerAlign" style="width:95px;">@item.STR_START_DATE_STRING</td>
                    <td class="labelClass centerAlign" style="width:95px;">@item.STR_END_DATE_STRING</td>
                    <td class="labelClass padddingLeft tdNoWrap CharactFieldsClass" rowspan="2">@item.PP_CUSTOMER_NAME</td>
