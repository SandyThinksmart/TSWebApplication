@using TSWebApplication.Domain.Resources
@using TSWebApplication.Domain.Model
@model List<HSKMillSheetDetails>
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lblMenu_HSKMillSheetSave").Value.Replace("</br>", "");
    Layout = "~/Views/Shared/_Layout.cshtml";
    DateTime fromDate = DateTime.Now;
    fromDate = fromDate.AddMonths(-3);

    DateTime toDate = DateTime.Now;
}


<link href="~/css/Common_Styles.css" rel="stylesheet" />
<link href="~/css/HSKMillSheetHistoryPopup.css" rel="stylesheet" />

<link href="~/css/Common.css" rel="stylesheet" />
<link href="~/css/masterStyles.css" rel="stylesheet" />


<style type="text/css">
    .hide {
        display: none;
    }

    .header {
        padding-left: 3px;
    }

    .freez > td {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .HeaderPadding {
        padding-left: 10px;
        padding-right: 10px;
        white-space: nowrap;
    }

    .rightPadding {
        padding-right: 2px;
    }

    .disabled {
        background-color: #EEEEEE !important;
        color: black;
    }
</style>



<br />
<br />
