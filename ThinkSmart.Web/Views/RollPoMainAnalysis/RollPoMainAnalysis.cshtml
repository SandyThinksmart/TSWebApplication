@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lbl_MaterailPoMainAnalysis");
    Layout = "~/Views/Shared/_Layout.cshtml";
    string executeBatch = @Configuration.GetSection("Import_PO_Batches")["Value"];
}
<style>
    div.fixed {
        position: fixed;
        padding-top: 2px;
        margin-left: 50%;
    }

    #LoadingImage {
        position: fixed;
        display: block;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        text-align: center;
        opacity: 0.7;
        background-color: #fff;
        z-index: 99;
        padding-top: 20%;
    }

    #loadImage {
        position: absolute;
        padding-top: 40%;
        top: 100px;
        left: 280px;
        z-index: 100;
    }

    .disabled {
        background-color: #EEEEEE !important;
        color: black;
    }
</style>


