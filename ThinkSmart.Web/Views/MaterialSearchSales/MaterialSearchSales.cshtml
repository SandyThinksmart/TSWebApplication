}
<style type="text/css">
    .hide {
        display: none;
    }

    .header {
        padding-left: 3px;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freez2 > th {
        position: sticky !important;
        background-color: #B2C3E6;
        top: 21px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freez3 > th {
        position: sticky !important;
        background-color: #B2C3E6;
        top: 41.5px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freez4 > th {
        position: sticky !important;
        background-color: #B2C3E6;
        top: 62px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freez5 > th {
        position: sticky !important;
        background-color: #B2C3E6;
        top: 83.5px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }
</style>


