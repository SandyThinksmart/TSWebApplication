@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@using TSWebApplication.Domain.Utility
@model Tuple<GridSearchFields>

@{
    ViewData["Title"] = @LocalizationServices.GetLocalizedHtmlString("title_MaterialList");
}
<link href="~/css/Common_Styles.css" rel="stylesheet" />
<link href="~/css/Common.css" rel="stylesheet" />
<link href="~/css/masterStyles.css" rel="stylesheet" />
<style>
    .searchNameTxtBoxWidth {
        width: 100px;
    }

    .searchDimTxtBoxWidth {
        width: 100px;
    }

    .extractSortBtn {
        width: 67px;
    }

    .txtLengthDim {
        width: 55px;
    }

    .txtShape {
        width: 22px;
    }

    .txtProdSpecNo {
        width: 45px;
    }

    .ddlWidth {
        width: 95px;
        border-style: none;
    }
</style>
<div class="modal fade" id="AnalysePoQtyMaterialListPopupModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true" style="padding-left: 353px;">
    <div class="modal-dialog-centered" role="document">
        <div class="modal-content" style="width:1127px">


            <div style="width: 1010px;padding-top:14px;">
                <div>
                    <table id="tblSearch" style="width: 1122px" cellpadding="0" cellspacing="0" border="0">
                        <tr style="height:20px;">
                            <td align="center" valign="middle" class="tdH1" style="width: 684px;">
                                <label ID="lblKoubanSearchGridHeader"
                                       class="labelClass1" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_SearchCondition")</label>
                            </td>
                            <td style="width: 251px"></td>
                            <td align="center" valign="middle" rowspan="2" bgcolor="#006666" style="width: 160px">
                                <table cellpadding="2" cellspacing="2" style="height: 65px">
                                    <tr>
                                        <td align="center" colspan="2">
                                            <label ID="lblAuxiliaryFunctionSearchSort" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_FilterCondition")</label>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Extract")" ID="btnSearchMaterial" class="_functionButtons extractSortBtn" TabIndex="41" />
                                        </td>
                                        <td>
                                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Sort_L")" ID="btnSortOnMaterial" class="_functionButtons extractSortBtn" TabIndex="42" />
                                        </td>
                                    </tr>
                                </table>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <div id="pnlSearch" style="overflow-x: auto;overflow-y: hidden;">

                                    <table cellpadding="4" cellspacing="4" border="0" class="searchTextBox tdGridHeader">
                                        <tr class="trTdH2">
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_MakerMaster")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_InternalName")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_MatlNameMaker")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter" colspan="2">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_Shape")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter" colspan="2">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_Length")</label>
                                            </th>
                                            @* <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                            <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_LengthEnds")</label>
                                            </th>*@
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_GeneralSpecial_L")</label>
                                            </th>
                                            <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                                <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialKubun_L")</label>
                                            </th>
                                            @* <th align="left" valign="middle" class="tdHeaderClass labelClass GridCenter">
                                            <label class="labelClass1">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialMaker")</label>
                                            </th>*@
                                        </tr>
                                        <tr class="trTdSearchContent">
                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtMakerNameOnMatl" MaxLength="20"
                                                       TabIndex="31" class="labelClass searchNameTxtBoxWidth"><span class="text-danger"></span>
                                            </td>
                                            <td class="td tdSearchGrid ">
                                                <input type="text" ID="txtInternalNameOnMatl" MaxLength="20"
                                                       TabIndex="32" class="labelClass searchNameTxtBoxWidth"><span class="text-danger"></span>

                                            </td>
                                            <td class="td tdSearchGrid ">
                                                <input type="text" ID="txtRawMaterialNameOnMatl" MaxLength="20"
                                                       TabIndex="33" class="labelClass searchNameTxtBoxWidth"><span class="text-danger"></span>

                                            </td>

                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtDiaMinOnMatl" MaxLength="7" TabIndex="34" class=" labelClass FitSearchTextBox txtLengthDim" style="width:65px"
                                                       onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))">
                                            </td>
                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtDiaMaxOnMatl" MaxLength="7" TabIndex="35" class="labelClass FitSearchTextBox txtLengthDim" style="width:65px"
                                                       onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))">
                                            </td>
                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtShapeOnMatl" runat="server" class="UpperCase labelClass FitSearchTextBox txtShape" onkeyup="ToUpper(this)" onkeypress="return (event.charCode !=65 && event.charCode ==90 || (event.charCode >= 97 && event.charCode <= 123))"
                                                       MaxLength="2" tabindex="36" />
                                            </td>
                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtLengthMinOnMatl" MaxLength="7" TabIndex="37" class="labelClass FitSearchTextBox txtLengthDim" style="width:65px"
                                                       onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))" />
                                            </td>
                                            <td class="td tdSearchGrid">
                                                <input type="text" ID="txtLengthMaxOnMatl" MaxLength="7" TabIndex="38" class="labelClass FitSearchTextBox txtLengthDim" style="width:65px"
                                                       onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))" />
                                            </td>
                                            <td class="td tdSearchGrid ">
                                                <select ID="ddlMatlSpecName" runat="server" tabindex="39" class=" dropListClass ddlWidth">
                                                </select>

                                            </td>
                                            <td class="td tdSearchGrid ">
                                                <select ID="ddlMaterialType" runat="server" tabindex="40" class=" dropListClass ddlWidth">
                                                </select>

                                            </td>

                                        </tr>
                                    </table>
                                </div>
                            </td>
                        </tr>

                    </table>

                </div>
            </div>
            <div>
                <table id="tblMaterialList" style="width: 1121px;height:370px;overflow:auto;" cellpadding="0" cellspacing="0" border="1">
                    <tr>
                        <th style="vertical-align: top;">

                            <div id="divMaterialMasterListGrid" style="height: 363px;overflow: auto;width:1122px;">
                                @{
                                    //@await Html.PartialAsync("MaterialList", Model)
                                    @await Html.PartialAsync("~/Views/RollPoMainAnalysis/AnalysePoQtyMaterialList.cshtml",Model)
                                }
                            </div>

                        </th>
                    </tr>
                </table>
            </div>
            <div>
                <table style="width:1122px;">
                    <tr>
                        <td>
                            <table border="0" cellpadding="2" cellspacing="2" style="border:2px inset lightgrey">
                                <tr>
                                    <td style="background-color: #C00000; border-width: 0px; border-style: none;padding-left:5px;padding-right:5px;">
                                        <table border="0" cellpadding="2" cellspacing="2" style="height:60px;width:113px;">
                                            <tr>
                                                <td align="center" colspan="4" valign="bottom">
                                                    <label ID="Label3" class="labelClass" style="color:white;padding-top:5px;">@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")</label>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td align="center">
                                                    <input type="button" style="width: 110px;" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="btnInitializeOnMaterial" class="_functionButtons" TabIndex="43" />
                                                </td>

                                            </tr>

                                        </table>

                                    </td>
                                </tr>
                            </table>
                        </td>
                        <td style="width:955px;"></td>
                        <td>
                            <table border="0" cellpadding="2" cellspacing="2" style="border:2px inset lightgrey">
                                <tr>
                                    <td style="background-color: navy; border-width: 0px; border-style: none;padding-left:5px;padding-right:5px;width: 191px;">
                                        <table border="0" cellpadding="2" cellspacing="2" style="height:60px;width:101px;">
                                            <tr>
                                                <td align="center" colspan="4" valign="bottom">
                                                    <label ID="Label3" class="labelClass" style="color:white;padding-top:5px;">@LocalizationServices.GetLocalizedHtmlString("btn_Cancel")</label>
                                                </td>
                                            </tr>
                                            <tr>
                                                @*  <td align="center">
                                                <input style="width: 95px;" type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_OK")" ID="btnInitialize" class="_functionButtons" TabIndex="1" />
                                                </td>*@
                                                <td align="center">
                                                    <input type="button" style="width: 95px;" value="@LocalizationServices.GetLocalizedHtmlString("btn_Cancel")" ID="btnCancelOnMaterial" onclick="OnMaterialCancelBtnClick($(this))" class="_functionButtons" TabIndex="44" />
                                                </td>
                                            </tr>

                                        </table>

                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </div>



        </div>
    </div>
</div>
<div id="SortPopUpModalForMaterial">
    @{
        @await Html.PartialAsync("~/Views/Shared/SortPopUp.cshtml")
        ;
    }
</div>
@section Scripts{

    <script src="~/static/js/RollSalesMaterialForecast.js"></script>


}
