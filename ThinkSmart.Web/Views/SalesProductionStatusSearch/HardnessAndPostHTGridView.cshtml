                                    <td class="GridRight">@if (@item.YIELD_POINT != 0){@item.YIELD_POINT}</td>
                                    <td class="GridCenter">@item.ELONGATION_PATTERN1_STRING</td>
                                <td class="GridRight">@if (!string.IsNullOrEmpty(@item.ELONGATION_STRING)){@item.ELONGATION_STRING}</td>
                                    <td class="GridCenter"> @item.PRESS_PATTERN1_STRING</td>
