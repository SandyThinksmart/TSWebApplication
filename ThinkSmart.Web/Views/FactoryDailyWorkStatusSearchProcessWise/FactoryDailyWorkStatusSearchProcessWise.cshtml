<style type="text/css">
    .hide {
        display: none;
    }

    .header {
        padding-left: 3px;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .HeaderPadding {
        padding-left: 10px;
        padding-right: 10px;
        white-space: nowrap;
    }

    .rightPadding {
        padding-right: 2px;
    }

    .freez {
        border-color: white;
    }

    .disabled {
        background-color: #EEEEEE !important;
        color: black;
    }

    #LoadingImage {
        position: fixed;
        display: block;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        text-align: center;
        opacity: 0.7;
        background-color: #fff;
        z-index: 99;
        padding-top: 15%;
    }

    .footerRow {
        background-color: lightgoldenrodyellow;
        height: 21px;
        position: sticky;
        bottom: 0;
        z-index: 1;
    }
    #loadimage {
        position: absolute;
        padding-top: 40%;
        top: 100px;
        left: 280px;
        z-index: 100;
    }
</style>
