@using TSWebApplication.Domain.Resources
@using TSWebApplication.Domain.Model
@inject LocalizationServices LocalizationServices
@model List<HardeningTemperingDetails>
@{
   
}
<style type="text/css">
    .hide {
        display: none;
    }

    .header {
        padding-left: 3px;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .HeaderPadding {
        padding-left: 10px;
        padding-right: 10px;
    }
</style>
<script>
    window.onload = function() {


        window.resizeTo(1140, 660);

    };
</script>
<tsSortPopUp:SortPopup ID="tsSortPopup" OnSortOKClick="tsSortPopup_OKClick" />
<link href="~/css/Common.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/HardnessTempering.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/Common_Styles.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/masterStyles.css" rel="stylesheet" asp-append-version="true" />
<br />
<br />

<div id="divMain" style="margin: auto 0px auto 0px;">
   @* <input type="hidden" value="@fromEntryEditDelete.ToString()" id="fromEntryEditDelete"/>*@
    <div id="divSearch" class="searchBar">
        <div style="width: 1060px">
            <table cellpadding="0" cellspacing="0" border="0" frame="border" style="border-collapse: collapse; width: 1050px">
                <tr>
                    <td valign="bottom" style="width: 850px; height: 70px">
                        <table cellpadding="0" cellspacing="0" border="0" style="width: 879px" class="searchTextBox">
                            <tr style="height:20px">
                                <td align="center" valign="middle" bgcolor="#4E6CAB">
                                    <label ID="lblKoubanSearchGridHeader"
                                           class="labelClass1" Style="display: inline-block; color: White; background-color: #4E6CAB;">@LocalizationServices.GetLocalizedHtmlString("lbl_SearchCondition")</label>
                                </td>
                            </tr>
                        </table>
                        <table cellpadding="0" cellspacing="0" border="0" style="width: 880px" class="searchTextBox">
                            @*add 60px to 1720px*@
                            <tr class="trTdH2" style="height:20px;">
                                <td class="tdH2" style="width:90px">
                                    <label ID="lblChuubanSearch"
                                           class="labelClass 1 GridChuuban GridAlignmentChuuban">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="lbl_FurnaceNum"
                                           class="labelClass" ForeColor="Black">@LocalizationServices.GetLocalizedHtmlString("lbl_FurnaceNum")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="lblProdSpecNo1Search"
                                           class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="lblSalesInchargeSearch" class="  labelClass 1  GridAlignmentSalesIncharge">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</label>
                                </td>

                                <td class="tdH2" style="width:80px">
                                    <label ID="lbl_MaterialDimD"
                                           wrap="false" class="labelClass" ForeColor="Black">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialDimD")</label>
                                </td>

                                <td class="tdH2" style="width:80px">
                                    <label ID="lbl_ProductDim"
                                           wrap="false" class="labelClass" ForeColor="Black">@LocalizationServices.GetLocalizedHtmlString("lbl_ProductDim")</label>
                                </td>



                                <td colspan="2" class="tdH2">
                                    <label ID="lblDimDSearch"
                                           class="labelClass" ForeColor="Black">@LocalizationServices.GetLocalizedHtmlString("lbl_InspectionDate")</label>
                                </td>
                            </tr>
                            <tr class="trTdSearchContent">
                                <td class="td tdSearchGrid" style="height:28px;">
                                    <input type="text" ID="txtchuban" class="UpperCase InActiveIMEMode labelClass" style="width:90px;height:22px"
                                           onkeypress="return (event.charCode !=8 && event.charCode ==0 || (event.charCode >= 48 && event.charCode <= 57))" maxlength="12" TabIndex="1"><span class="text-danger"></span>

                                </td>
                                <td class="td tdSearchGrid" style="width: 120px">
                                    <input type="text" ID="txtFurnaceNum" class="UpperCase InActiveIMEMode labelClass" style="width: 120px;height:22px"
                                         maxlength="10"  TabIndex="2"><span class="text-danger"></span>
                                </td>

                                <td class="td tdSearchGrid">
                                    <div id="divCustomer">

                                        @{
                                            var custObject = Tuple.Create("txtInputSearch", "btnCustomerSearch", "ddlCustomer", "", 3);
                                            @Html.Partial("~/Views/SearchComboCustomer/SearchComboCustomer.cshtml", custObject)

                                        }
                                    </div>
                                   
                                </td>

                                <td class="td tdSearchGrid" style="width: 120px">
                                    <input type="text" ID="txtProdName" class="UpperCase InActiveIMEMode labelClass" style="width: 120px;height:22px" MaxLength="20" TabIndex="6"><span class="text-danger"></span>
                                </td>
                                <td class="td tdSearchGrid" style="width: 50px">
                                    <input type="text" ID="txtMatrialD" MaxLength="7" TabIndex="7" class="InActiveIMEMode labelClass" style="width: 90px;height:22px;text-align:right;" onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))">
                                    <span class="text-danger"></span>

                                </td>
                                <td class="td tdSearchGrid">
                                    <input type="text" ID="txtProductDim" MaxLength="7" TabIndex="8" class="InActiveIMEMode labelClass" style="width: 90px;height:22px;text-align:right;" onkeypress="return (event.charCode !=8 && event.charCode ==0 || ( event.charCode == 46 || (event.charCode >= 48 && event.charCode <= 57)))">
                                    <span class="text-danger"></span>

                                </td>


                                <td class="td tdSearchGrid" style="width: 80px">
                                    <input type="text" ID="txtSrchTransferStartDate" MaxLength="10" TabIndex="9" class="InActiveIMEMode labelClass" style="width: 80px;height:22px"><span class="text-danger"></span>
                                </td>
                                <td class="td tdSearchGrid" style="width: 80px">

                                    <input type="text" ID="txtSrchTransferEndDate" TabIndex="10" MaxLength="10" class="InActiveIMEMode labelClass" style="width: 80px;height:22px"><span class="text-danger"></span>

                                </td>
                            </tr>
                        </table>
                    </td>

                    <td align="left">
                        <table style="width: 190px; height: 70px; margin-left: 5px; background-color: #006666">
                            <tr>
                                <td align="center" style="vertical-align: bottom" colspan="2">
                                    <label ID="Label1"
                                           style="color:white;" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_AuxiliaryFunctionSearchSort_L")</label>
                                </td>
                            </tr>
                            <tr>
                                <td width="50%" align="center">
                                    <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Extract")" ID="btnSearch"
                                           class="_functionButtons" TabIndex="11" onclick="btnSearch_Click()" />
                                </td>
                                <td align="center">
                                    <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Sort_L")" ID="btnSort"
                                           TabIndex="12" class="_functionButtons" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>


    </div>
    <div id="divMainHardnessTemperingList">
        @{
            @await Html.PartialAsync("HardnessTemperingListGrid", Model)
            ;
        }
    </div>
    
    <br />


    <table style="width: 1077px">
        <tr>
            <td width="855px"></td>
            <td align="right" style="width: 5%; height: 50px; background-color: brown;">
                <table width="100px" cellpadding="2" cellspacing="2">
                    <tr>
                        <td align="center">
                            <label ID="Label15" class="labelClass" style="color:white;" Text="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")">@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")</label>
                        </td>
                    </tr>
                    <tr>
                        <td align="center">
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="btnInitialize" class="_functionButtons" TabIndex="13" style="width:90px;" />
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width:3px;"></td>
            <td align="right" style="width: 5%; background-color: Blue;">

                <table width="100px" cellpadding="2" cellspacing="2">
                    <tr>
                        <td align="center">
                            <label ID="lblClose"
                                   style="color:white;" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                        </td>
                    </tr>
                    <tr>
                        <td align="center">
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnGoBack"
                                   style="width:90px;" TabIndex="14" class="_functionButtons" />
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

    </table>


</div>
<div id="SortPopUpModalMain">
    @{
        @await Html.PartialAsync("~/Views/Shared/SortPopUp.cshtml")
        ;
    }
</div>

@section Scripts{
    <script src="~/Static/js/HardnessTemperingList.js" asp-append-version="true"></script>
    
}
<div id="divErrorMessages" class="Hidden">
    <label id="lblErrorMessageE_HARDNESS_LIST_001" class="Hidden">
        <span ID="LiteralEnterAtLeastOneSearchCondition">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_EnterAtLeastOneSearchCondition")</span>
    </label>

    

    <label id="lblErrorMessageE_HARDNESS_LIST_002" class="Hidden">
        <span ID="LiteralStartDateRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_StartDateRequired")</span>
    </label>

    <label id="lblErrorMessageE_HARDNESS_LIST_003" class="Hidden">
        <span ID="LiteralInspStartDate_Invalid">@LocalizationServices.GetLocalizedHtmlString("valMsg_InspStartDate_Invalid")</span>
    </label>

    <label id="lblErrorMessageE_HARDNESS_LIST_004" class="Hidden">
        <span ID="LiteralInspEndDate_Invalid">@LocalizationServices.GetLocalizedHtmlString("valMsg_InspEndDate_Invalid")</span>
    </label>

    <label id="lblErrorMessageE_HARDNESS_LIST_005" class="Hidden">
        <span ID="LiteralFinalInsStartIsGreaterThanEnd">@LocalizationServices.GetLocalizedHtmlString("valMsg_FinalInsStartIsGreaterThanEnd")</span>
    </label>

    <label id="lblErrorMessageE_HARDNESS_LIST_006" class="Hidden">
        <span ID="LiteralSystemException">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
    </label>
    
</div>
<label id="lblTitle_TemperingEditDelete" class="Hidden">
    <span ID="Literal_TemperingEditDelete" class="Hidden">@LocalizationServices.GetLocalizedHtmlString("lblMenu_TemperingEditDelete")</span>
</label>
<label id="lblTitle_TemperingJudgementEntryEditDelete" class="Hidden">
    <span ID="Literal_TemperingJudgementEntryEditDelete" class="Hidden">@LocalizationServices.GetLocalizedHtmlString("lbl_Menu_TemperingJudgementEntryEditDelete")</span>
</label>