            <th id="strng2ExtCondtion" class="headerPadding bgcolor1 labelClass tdNoWrap Proceplanwidth1">@LocalizationServices.GetLocalizedHtmlString("lbl_ExtConditions")</th>
            <th id="strngThabaNo" rowspan="2" class="headerPadding bgcolor1  labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_TabaNo")</th>
            <th id="strng2Remark" rowspan="2" class="headerPadding bgcolor1 labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Remark") </th>
            <th id="strng2Decision" rowspan="2" class="headerPadding bgcolor1 labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Decision") </th>
            <th id="nextProcess" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lblNextProcess")</th>
        </tr>

        <tr class="GridHeader GridViewScrollHeader freezStraighteing2DailyGrid2 GridHeaderPadding gridHeaderBgColor">
