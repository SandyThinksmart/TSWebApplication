<script>
    $(document).ready(function () {

        var vehicleId = '@ViewBag.VehicleId';

        if (vehicleId && vehicleId != '0') {
            loadVehicleDetails(vehicleId);
             enableCopyButtons();
        enableEditButtons();
        enableDeleteButtons();
        enableUnUseButtons();
        disableSaveButtons();
        enableSelectButtons();
        }
    });
</script>