<label id="lblYes" class="Hidden">@LocalizationServices.GetLocalizedHtmlString("lbl_Yes")</label>
<label id="lblNo" class="Hidden">@LocalizationServices.GetLocalizedHtmlString("lbl_No")</label>
<div id="divErrorMessages" class="Hidden">
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_001" class="Hidden">
        <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
    </label>
    <label id="lblErrorMessageE_PDF_SELECT_01" class="Hidden">
        <span ID="LiteralPDFSelectRequired">@LocalizationServices.GetLocalizedHtmlString("ValMsg_PDFSelected")</span>
    </label>
    <label id="lblErrorMessageE_PDF_Extention_02" class="Hidden">
        <span ID="LiteralPDFSelectRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_CheckPDFExtention")</span>
    </label>
    <label id="lblErrorMessageE_KubunAlreadyUse_03" class="Hidden">
        <span ID="LiteralKoubanAlreadyExist">@LocalizationServices.GetLocalizedHtmlString("valMsg_KoubanAlreadyExist")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_NEXT_PRIVIOUS_004" class="Hidden">
        <span ID="LiteralPDFNotFound">@LocalizationServices.GetLocalizedHtmlString("Record Not Found")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_005" class="Hidden">
        <span ID="LiteralTemplateNameRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_TemplateNameRequired")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_006" class="Hidden">
        <span ID="LiteralPDF_Instruction">@LocalizationServices.GetLocalizedHtmlString("lbl_PDF_Instruction")</span>
    </label>
    
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_007" class="Hidden">
        <span ID="LiteralCC_MinIsLessThanMax">@LocalizationServices.GetLocalizedHtmlString("valMsg_CC_MinGreaterThanMax")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_008" class="Hidden">
        <span ID="LiteralHardnessMinIsLessThanMax">@LocalizationServices.GetLocalizedHtmlString("valMsg_HardnessMinGreaterThanMax")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_009" class="Hidden">
        <span ID="LiteralMillsheetConfirmRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_MillsheetConfirmRequired")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_010" class="Hidden">
        <span ID="LiteralMillsheetConfirmRequired">@LocalizationServices.GetLocalizedHtmlString("valMsg_FileRequired")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_011" class="Hidden">
        <span ID="LiteralUnableToConnectMillsheetFTP">@LocalizationServices.GetLocalizedHtmlString("valMsg_UnableToConnectMillsheetFTP")</span>
    </label>
    <label id="lblErrorMessageE_MAKERMILLSHEET_ENTRY_012" class="Hidden">
        <span ID="LiteralOCRUnconfirmedData">@LocalizationServices.GetLocalizedHtmlString("valMsg_OCRUnconfirmedData")</span>
    </label>
    

</div>

<div id="divSuccessMessages" class="Hidden">
    <label id="lblSuccessMessageS_MAKERMILLSHEET_ENTRY_001" class="Hidden">
        <span ID="Literal1">@LocalizationServices.GetLocalizedHtmlString("successMsg_COM_DataSaved")</span>
    </label>

    <label id="lblSuccessMessageE_MAKERMILLSHEET_ENTRY_EDIT_DELETE_002" class="Hidden">
        <span ID="LiteralDataUpdated">@LocalizationServices.GetLocalizedHtmlString("successMsg_COM_DataUpdated")</span>
    </label>

    <label id="lblSuccessMessageE_MAKERMILLSHEET_ENTRY_EDIT_DELETE_003" class="Hidden">
        <span ID="LiteralDataDeleted">@LocalizationServices.GetLocalizedHtmlString("successMsg_COM_DataDeleted")</span>
    </label>


</div>
<div id="LoadingImage" style="display: none">
    <img id="loadImage" src="~/images/loading.gif" height="60px" width="60px" />
</div>
@section Scripts {

    <script src="~/scripts/pdfreader/pdf.js" asp-append-version="true"></script>
   
   <script src="~/scripts/pdfreader/workerpdf.js" asp-append-version="true"></script>
     @*  <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script> *@
    <script src="~/static/js/MakerMillSheet.js" asp-append-version="true"></script>
}