@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lblMenu_RollForecastPopup").Value.Replace("<br>", "");
}

<table border="0" cellpadding="0" cellspacing="0" width="1300px" id="tblMain" style="margin-top:20px;">
   
    <tr>
        <td align="left" valign="top">
            <div id="pnlOneMonthProductForecastGrid">
                @{
                    @await Html.PartialAsync("~/Views/RollPOMainAnalysis/OneMonthProductForecastGrid.cshtml")
                    ;
                }
            </div>
        </td>
    </tr>
    <tr>
        <td align="left" valign="top">
            <div id="pnlOneMonthMaterialForecastGrid">
                @{
                    @await Html.PartialAsync("~/Views/RollPOMainAnalysis/OneMonthMaterialForecastGrid.cshtml")
                    ;
                }
            </div>
        </td>
    </tr>
    <tr>
        
    </tr>
    
    <tr>
        <td align="right" valign="top">
            <div id="pnlBottom">
                <table>
                    <tr>
                      
                        <td align="center" valign="middle" rowspan="2" bgcolor="green" style="width: 175px">
                            <table cellpadding="2" cellspacing="2" style="height: 65px">
                                <tr>
                                    <td align="center" colspan="2" style="padding-top: 10px;">
                                        <label ID="lblAuxiliaryFunctionSearchSort" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_SalesStatus")</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_ByProductSpec")" ID="btnByProductSpec" class="_functionButtons" style="width:90px" />
                                    </td>
                                    <td>
                                        <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_ByCustomer")" ID="btnByCustomer" class="_functionButtons" style="width:80px" />
                                    </td>
                                </tr>
                            </table>
                        </td>
                        
                    </tr>
                </table>
            </div>
        </td>
    </tr>
</table>
<div id="divErrorMessages" class="Hidden">
    <label id="lblErrorMessageE_SelectAtLeastOne" class="Hidden">
        <span ID="LiteralSelectAtLeastOne">@LocalizationServices.GetLocalizedHtmlString("errorMsg_SelectAtLeastOne")</span>
    </label>
    </div>

<div id="SortPopUpModalMain">
    @{
        @await Html.PartialAsync("~/Views/Shared/SortPopUp.cshtml")
        ;
    }
</div>
@section Scripts {
    <script src="~/static/js/RollForcastPopUp.js"></script>
    <link href="~/css/Common.css" rel="stylesheet" />
    <link href="~/css/AnalysePOQuantity.css" rel="stylesheet" />
    <link href="~/css/Common_Styles.css" rel="stylesheet" />
    <link href="~/css/masterStyles.css" rel="stylesheet" />


}
