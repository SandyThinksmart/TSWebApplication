@using TSWebApplication.Domain.Resources
@inject LocalizationServices LocalizationServices
@using TSWebApplication.Domain.Model
@model List<HeatTreatMentDetails>
@{
    //ViewData["Title"] = "Privacy Policy";
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("lblMenu_HeatTreatmentEditDelete").Value.Replace("</br>", "");
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<link href="~/css/Common_Styles.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/FixedHeader.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/masterStyles.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/Common.css" rel="stylesheet" asp-append-version="true" />


<style type="text/css">
    .hide {
        display: none;
    }

    .headerPadding {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .fixLengthDataPadding {
        padding-left: 5px !important;
        padding-right: 5px !important;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        border-color: white;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }
</style>

    <asp:ScriptManager ID="ScriptManager1">
    </asp:ScriptManager>
    <div id="divMain" style="margin: auto 0px auto 0px;">
        <Panel ID="pnlProductSearch" runat="server">
            <table cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; width: 790px;margin-top: 16px;">
                <tr>
                    <td valign="bottom" style="width: 585px; height: 70px">
                        <table cellpadding="0" cellspacing="0" style="height: 70px">
                            <tr>
                                <td colspan="6" valign="bottom" align="center" style="height: 15px; background-color: #4E6CAB">
                                    <label ID="lblPostHTSearchGridHeader"
                                           style="Color:White;padding-top: 3px;" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_SearchCondition")</label>

                                </td>
                            </tr>
                            <tr>
                                <td class="tdH2">
                                    <label ID="lblSrchMachine" Class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_FurnaceProc")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="lblSrchFurnaceNum" Class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_FurnaceNum")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="Label2" CssClass="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcCondition")</label>
                                </td>
                                <td class="tdH2">
                                    <label ID="Label3" CssClass="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_PatternNo")</label>

                                </td>
                                <td colspan="2" class="tdH2">
                                    <label ID="lblInspectionDate" CssClass="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_FurnaceInDateTime")</label>

                                </td>
                            </tr>
                            <tr>
                                <td class="tdSerachComponant" style="width: 120px">
                                    @* <input type="d" ID="txtmachine" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                    BorderStyle="Inset" MaxLength="30" TabIndex="2" />*@

                                    <select ID="ddlMachine" runat="server" class=" form-control TextFieldsClass " style="border-style:inset; padding-bottom:2px;font-family:'MS Gothic'; Height:22px; Width:127px" TabIndex="1">
                                    </select>

                                </td>
                                <td class="tdSerachComponant" style="width: 120px">
                                    <input type="text" ID="txtFurnaceNo" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                           BorderStyle="Inset" MaxLength="11" TabIndex="2" />

                                </td>
                                <td class="tdSerachComponant" style="width: 120px">
                                    @* <input type="text" ID="txtSrchProcCond" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                    BorderStyle="Inset" MaxLength="30" TabIndex="2" />*@
                                    <select ID="ddlProcCondition" runat="server" class=" form-control TextFieldsClass " style="border-style:inset; padding-bottom:2px;font-family:'MS Gothic'; Height:22px; Width:127px" TabIndex="3">
                                    </select>

                                </td>
                                <td class="tdSerachComponant" style="width: 150px">
                                    <input type="text" ID="txtPatternNo" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                           BorderStyle="Inset" MaxLength="2" TabIndex="4" />

                                    <AjaxToolKit:FilteredTextBoxExtender ID="fteSrchPatternNo" runat="server" Enabled="True"
                                                                         TargetControlID="txtSrchPatternNo" ValidChars="0123456789">
                                    </AjaxToolKit:FilteredTextBoxExtender>

                                </td>
                                <td class="td tdSearchGrid " style="width: 168px">
                                    <input type="text" ID="txtSrchDateStart" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                           BorderStyle="Inset" MaxLength="2" TabIndex="5" />

                                </td>
                                <td class="td tdSearchGrid " style="width: 168px">
                                    <input type="text" ID="txtSrchDateEnd" runat="server" class=" form-control UpperCase TextFieldsClass" style="border-style: none;font-family:'MS Gothic';Width:96%; Height:22px" ;
                                           BorderStyle="Inset" MaxLength="2" TabIndex="6" />

                                </td>
                            </tr>
                        </table>

                    </td>

                    @*<td style="width: 12px"></td>*@
                    <td style="text-align:right">
                        <table style="width: 200px; height: 70px; margin-left: 5px;background-color: #006666;">
                            <tr>
                                <td style="vertical-align:bottom; text-align:center" colspan="2">
                                    <label ID="Label1"
                                           style="color:white" CssClass="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_AuxiliaryFunctionSearchSort_L")</label>
                                </td>
                            </tr>
                            <tr>
                                <td style="text-align:center;" width="50%">
                                    <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Extract")" ID="btnSearch" ValidationGroup="TrnValidation" class="_functionButtons"
                                           style="width: 90px" CausesValidation="false" TabIndex="6" OnClick="btnSearch_Click()" />
                                </td>
                                <td style="text-align:center;">
                                    <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Sort_L")" ID="btnSort" ValidationGroup="TrnValidation" class="_functionButtons"
                                           style="width: 90px" CausesValidation="false" TabIndex="7" />


                                    <AjaxToolKit:ModalPopupExtender ID="ModalPopupExtender1" runat="server"
                                                                    TargetControlID="btnSort" PopupControlID="pnlSortPanel" BackgroundCssClass="popupbg"
                                                                    DropShadow="false" />
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </Panel>
    </div>

    <div id="divMainHeatTreatMentList" style="margin: auto 0px auto 0px;">

        @{
            @await Html.PartialAsync("HeatTreatmentListGrid", Model)
            ;
        }

    </div>
    <div id="SortPopUpModalMain">
        @{
            @await Html.PartialAsync("~/Views/Shared/SortPopUp.cshtml")
            ;
        }
    </div>


    <div>

        <table style="width: 790px">
            <tr>
                <td align="left" style="width: 10%; height: 50px; background-color: DarkRed;">
                    <table width="100px" cellpadding="2" cellspacing="2">
                        <tr>
                            <td align="center">
                                <label ID="Label4" class="labelClass" style="Color:White">@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")</label>
                            </td>
                        </tr>
                        <tr>
                            <td align="center">
                                <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("lbl_Initialize")" ID="btnInitialize" class="_functionButtons" TabIndex="9"
                                       Width="90px" />
                            </td>
                        </tr>
                    </table>
                </td>
                <td></td>
                <td align="right" style="width: 10%;  height: 50px;background-color: navy;">
                    <table width="100px" cellpadding="2" cellspacing="2">
                        <tr>
                            <td align="center">
                                <label ID="lblClose"
                                       style="Color:White" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                            </td>
                        </tr>
                        <tr>
                            <td align="center">
                                <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="buttonClose"
                                       Width="90px" TabIndex="7" class="_functionButtons" />
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

        </table>
        <input type="hidden" id="hdfMachineCD" name="MachineCD" value="" />
        <input type="hidden" id="hdfFurNO" name="FurNO" value="" />


        <div id="divErrorMessages" class="Hidden">
            <label id="lblErrorMessageE_HT_EDIT_DELETE_List_001_SearchField" class="Hidden">
                <span ID="LiteralEnterAtLeastOneSearch">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_EnterAtLeastOneSearchCondition")</span>
            </label>
            <label id="lblErrorMessageE_HT_EDIT_DELETE_List_002_SearchField" class="Hidden">
                <span ID="LiteralMachineInactive">@LocalizationServices.GetLocalizedHtmlString("valMsg_InspStartDate_Invalid")</span>
            </label>
            <label id="lblErrorMessageE_HT_EDIT_DELETE_List_003_SearchField" class="Hidden">
                <span ID="LiteralMachineInactive">@LocalizationServices.GetLocalizedHtmlString("valMsg_InspEndDate_Invalid")</span>
            </label>
            <label id="lblErrorMessageE_HT_EDIT_DELETE_List_004_SearchField" class="Hidden">
                <span ID="LiteralMachineInactive">@LocalizationServices.GetLocalizedHtmlString("valMsg_InspStartDate_Required")</span>
            </label>
            <label id="lblErrorMessageE_HT_EDIT_DELETE_List_005_SearchField" class="Hidden">
                <span ID="LiteralExceptionOccured">@LocalizationServices.GetLocalizedHtmlString("valMsg_COM_SystemException")</span>
            </label>
        </div>
    </div>




@section Scripts{
    <script src="~/static/js/HeatTreatmentList.js" asp-append-version="true"></script>
    @* <script src="/Scripts/CommonScript.js"></script> *@
}