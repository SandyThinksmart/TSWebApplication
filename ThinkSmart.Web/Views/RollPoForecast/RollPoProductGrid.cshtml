<style type="text/css">
    .hide {
        display: none;
    }

    .header {
        padding-left: 3px;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .HeaderPadding {
        padding-left: 10px;
        padding-right: 10px;
    }
</style>
<style type="text/css">


    .freez > td {
        position: sticky !important;
        background-color: #7291D2;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .HeaderPadding {
        padding-left: 10px;
        padding-right: 10px;
        white-space: nowrap;
    }

    .rightPadding {
        padding-right: 2px;
    }

    .disabled {
        background-color: #EEEEEE !important;
        color: black;
    }
</style>

@if (Model != null && Model.Count > 0)
{
    var firstRecordDate = Model.First().ROLL_FC_DATE;

    <script>
        $(document).ready(function () {
        @if (firstRecordDate != DateTime.MinValue)
        {
            <text>
                        var dateFromPartial = '@firstRecordDate.ToString("yyyy-MM-dd")';
                        $("#txtDate").val(dateFromPartial);
            </text>
        }
        });
    </script>
}