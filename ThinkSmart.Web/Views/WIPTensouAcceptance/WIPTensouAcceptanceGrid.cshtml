                    <td class="labelClass" id=@("lblWidthAndOther" + i) style="background-color:#E2E2E2 !important"></td>
                    <td class="labelClass GridRight" id=@("lblLength" + i) style="background-color:#E2E2E2 !important"></td>
                            <td class="labelClass" id=@("lblCharge" + i) style="background-color:#E2E2E2 !important"></td>
                            <td class="labelClass" id=@("lblTabaNo" + i) style="background-color:#E2E2E2 !important;" align="center">
                            </td>
                    <td class="labelClass GridRight" id=@("lblNoOfUnits"+i) style="background-color:#E2E2E2 !important">
                        
                    </td>
                        
                        @* <input type="hidden" id=@("hdflNoOfUnits"+i) name="hdflNoOfUnits" value="" /></td> *@
                    
                    <td class="labelClass GridRight" id=@("lblWeightWithoutKG" + i) style="background-color:#E2E2E2 !important"></td>
                            <td class="MandatoryTD" style="width:135px">
                                <label ID="lblgdvf13"   style="Width:100%" Font-Size="12px" ForeColor="Black"  class="labelClass">

                            <select ID=@("ddlNextProcess" + i) TabIndex="2" class="GridMandatoryDropdown" style="Width:135px"></select>

                                    @LocalizationServices.GetLocalizedHtmlString("")</label>
                            </td>
                    <td class="labelClass"><input type="text" ID=@("txtSource" + i) class="TextBoxForGrid" style="Width:180px" TabIndex="3" Enabled="false"><span class="text-danger"></span></td>
                        </tr>
                   @* }*@
                }
        
          @*  }*@
            </tbody>
    </table>
</div>
<input type="hidden" id="hdfUnitType" value="" />
<input type="hidden" id="hdfNoOfUnits" value="" />
@section Scripts {
    <script src="~/static/js/wiptensouacceptance.js"></script>
}