@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<HikinukiDetails>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;

}
<style>
    .freezCombinedDailyGrid > th {
        position: sticky !important;
        background-color: #4e6cab;
        top: 0.0px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezCombinedDailyGrid {
        border-color: white;
    }

    .freezCombinedDailyGrid1 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 20px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezCombinedDailyGrid1 {
        border-color: white;
    }

    .freezCombinedDailyGrid2 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 40px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezCombinedDailyGrid2 {
        border-color: white;
    }

    .freezCombinedDailyGrid3 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 58px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezCombinedDailyGrid3 {
        border-color: white;
    }

    .freezCombinedDailyGrid4 > th {
        position: sticky !important;
        background-color: #7291D2;
        top: 79px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezCombinedDailyGrid4 {
        border-color: white;
    }
</style>
<div>
    <table class="GridLinesTable GridLayout GridColumnLeftPadding" cellpadding="0" cellspacing="0" border="1" id="tblCombineReport">
        <thead>
            <tr class="freezCombinedDailyGrid">

                <th id="CombineHeader" colspan="26" style="color:white;" class="GridHeader GridViewScrollHeader labelClass1 tdH1 sticky-header"> @LocalizationServices.GetLocalizedHtmlString("lbl_CombinedDailyReport") </th>
            </tr>
            <tr class="GridHeader GridViewScrollHeader freezCombinedDailyGrid1 GridHeaderPadding">
                <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter sticky-header" rowspan="4">

                </th>
                <th id="CombineProcessLocation" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessLocation")</th>
                <th id="CombineOperationDay" colspan="2" class="headerPadding labelClass tdNoWrap" style="width:80px;">@LocalizationServices.GetLocalizedHtmlString("lbl_OperationDayStartEnd")</th>
                <th id="CombineCustomer" rowspan="4" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</th>
                <th id="CombineChuuban" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</th>
                <th id="CombineVerification" colspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Verification")</th>
                <th id="CombineReserveQty" colspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ReserveQty")</th>
                <th id="CombineDimD" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</th>
                <th rowspan="4">
                    <label id="CombineDieDim1of2" class="headerPadding labelClass tdNoWrap" style="padding-bottom:5px !important">@LocalizationServices.GetLocalizedHtmlString("lbl_ReportDieDim1of2")</label><br />
                    <label id="CombineDimD1" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</label>
                    <label id="CombineDieDim" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_DieDim")</label>
                </th>
                <th id="CombineThabNo" rowspan="4" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_TabaNo")</th>
                <th id="CombineDimD2" rowspan="2" colspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</th>
                <th id="CombineLength" rowspan="2" colspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Length")</th>
                <th id="CombineFinishQty" rowspan="2" colspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DrawingUnitWt")</th>
                <th id="CombineBend" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Bend")</th>
                <th id="CombineExtTexture" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ExtTexture")</th>
                <th id="CombineDecision" rowspan="4" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Decision")</th>
                <th id="NextProcess" rowspan="4" class="headerPadding labelClass  tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lblNextProcess")</th>
            </tr>
            <tr class="GridHeader GridViewScrollHeader freezCombinedDailyGrid2 GridHeaderPadding">
                <th id="CombineMachine" colspan="2" rowspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Machine_L")</th>

                <th id="CombineOperator" rowspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Operator")</th>
                <th id="CombineManufacturingSpecificationNo" rowspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ManufacturingSpecificationNo")</th>
                <th id="CombineProdNameCust" rowspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</th>
                <th id="CombineMetallicLabelNo" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_MetallicLabelNo")</th>
                <th rowspan="3">
                    <label id="CombineMaterialDia" class="headerPadding labelClass tdNoWrap" style="padding-bottom:4px !important">@LocalizationServices.GetLocalizedHtmlString("lbl_Dim")</label>

                </th>
                <th id="CombineNoOfUnits" rowspan="3" class="headerPadding labelClass tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")
                    <label id="CombineReservePieces" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_ReservedPieces")</label>
                </th>
                <th id="CombineWeightWithoutKG" rowspan="3" class="headerPadding labelClass tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")
                    <label id="CombineReserveWeight" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_ReservedWeight")</label>
                </th>


                <th id="CombineLength1" rowspan="3" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Length")</th>


            </tr>
            <tr class="GridHeader GridViewScrollHeader freezCombinedDailyGrid3 GridHeaderPadding">
                <th id="CombineNo1" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberOne")
                    <label id="CombineDia1" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia1")</label>
                </th>
                <th id="CombineNo2" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberTwo")
                    <label id="CombineDia2" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia2")</label>
                </th>
                <th id="CombineNo3" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberThree")
                    <label id="CombineDia3" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia3")</label>
                </th>
                <th id="CombineNo1_1" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberOne")
                    <label id="CombineLen1" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Len1")</label>
                </th>
                <th id="CombineNo2_1" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberTwo")
                    <label id="CombineLen2" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Len2")</label>
                </th>
                <th id="CombineNo3_1" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberThree")
                    <label id="CombineLen3" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Len3")</label>
                </th>
                <th id="CombineNoOfUnits1" class="headerPadding labelClass tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")
                    <label id="CombineFinishedPieces" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_FinishedPieces")</label>
                </th>
                <th id="CombineWeightWithoutKG1" class="headerPadding labelClass tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")
                    <label id="CombineFinishedWeight" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_FinishedWeight")</label>
                </th>
                <th id="CombineECResult" colspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ECResult")</th>

            </tr>
            <tr class="GridHeader GridViewScrollHeader freezCombinedDailyGrid4 GridHeaderPadding">
                <th id="CombineCharge" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Charge")</th>
                <th id="CombineNo4" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberFour")
                    <label id="CombineDia4" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia4")</label>
                </th>
                <th id="CombineNo5" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberFive")
                    <label id="CombineDia5" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia5")</label>
                </th>
                <th id="CombineNo6" class="headerPadding labelClass NumberPadding tdNoWrap">
                    @LocalizationServices.GetLocalizedHtmlString("lbl_NumberSix")
                    <label id="CombineDia6" hidden>@LocalizationServices.GetLocalizedHtmlString("lbl_Dia6")</label>
                </th>
                <th id="CombineRemark" colspan="4" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Remark")</th>
                <th id="CombineMagnetismMT" class="headerPadding labelClass NumberPadding tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_MagnetismMT")</th>
                <th id="CombineShikii" class="headerPadding labelClass NumberPadding tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Shikii")</th>
                <th id="CombineNGBars" class="headerPadding labelClass NumberPadding tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lblNGBars")</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr class="GridNormalRow" data-lblProcessPlanCD="@item.PP_PROCESS_PLAN_CD">
                        <td rowspan="4" class="sticky-col1">
                            <input type="button" id="" ID="lnkEdit" class="btnArrow" onclick="OnEditClick($(this))" style="height:77px" CausesValidation="false" />
                        </td>
                        <td rowspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_LOCATION_NAME</td>
                        <td rowspan="2" class="labelClass centerAlign">@item.DW_START_DATE_STRING</td>
                        <td rowspan="2" class="labelClass centerAlign">@item.DW_END_DATE_STRING</td>
                        <td rowspan="4" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_CUSTOMER_NAME</td>
                        <td rowspan="2" class="labelClass tdNoWrap centerAlign">@item.PP_CHUUBAN</td>
                        <td rowspan="4" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_PROD_NAME_CUST</td>
                        <td rowspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.DW_METALLIC_PLATE_CODE</td>
                        <td rowspan="4" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_MATL_DIM_D @item.PP_MATL_SHAPE</td>
                        <td rowspan="4" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_NO_OF_UNITS @item.PP_UNIT_TYPE_STRING</td>
                        <td rowspan="4" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_ACT_ALLOC_QTY</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_PROD_DIM_D  @item.PP_PROD_SHAPE</td>
                        <td rowspan="4" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_DIE_DIM</td>
                        <td rowspan="4" class="labelClass centerAlign">
                            <span class="labelClass">@item.DW_TABA_NO_1_2</span>
                            <br>
                            <span class="labelClass">@item.DW_TABA_NO_3_4</span>
                        </td>

                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM1_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM2_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM3_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_LENGTH1</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_LENGTH2</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_LENGTH3</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_FINISHED_BARS @item.DW_UNIT_TYPE_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_FINISHED_QTY</td>
                        <td rowspan="2" class="labelClass tdNoWrap centerAlign">@item.DW_BEND_STATUS_DECODE</td>
                        <td rowspan="2" class="labelClass tdNoWrap centerAlign">@item.DW_EXT_TEXTURE_STATUS_DECODE</td>
                        <td rowspan="4" class="labelClass tdNoWrap centerAlign">@item.DW_DECISION_STRING</td>
                        <td rowspan="4" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.NEXT_PROCESS_NAME</td>
                    </tr>

                    <tr class="GridNormalRow">
                    </tr>

                    <tr class="GridNormalRow">
                        <td rowspan="2" colspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.DW_MACHINE_NAME</td>

                        <td rowspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.DW_END_OPERATOR_NAME</td>
                        <td rowspan="2" class="labelClass tdNoWrap centerAlign">@item.PROD_SPEC_NO</td>
                        <td rowspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_CHARGE</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_PROD_LENGTH_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM4_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM5_STRING</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_ACT_DIM6_STRING</td>
                        <td rowspan="2" colspan="4" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@Html.Raw(@item.DW_REMARKS.Replace("<br>", "<br/>"))</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_MAGNETISM</td>

                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_SHIKII_VALUE</td>
                        <td rowspan="2" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.DW_EC_NG_BAR_TOTAL</td>
                    </tr>

                    <tr class="GridNormalRow">
                    </tr>
                }
            }
            else
            {
                <tr class="GridNormalRow">
                    <td class="labelClass padddingLeft padddingRight " rowspan="4" style=" white-space:nowrap">
                        <input type="button" class="btnArrow" style="height:77px;float: right;" />
                    </td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" style="width: 95px;" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap">
                        <span class="labelClass"></span> <br>
                        <span class="labelClass"></span>
                    </td>

                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                </tr>

                <tr class="GridNormalRow">
                </tr>
                <tr class="GridNormalRow">
                    <td rowspan="2" colspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" colspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" colspan="4" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                    <td rowspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>


                </tr>
                <tr class="GridNormalRow">
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="footerRow" style="position: sticky !important;">
                <td colspan="10" align="right">
                    <label runat="server">@LocalizationServices.GetLocalizedHtmlString("lbl_TotalActAllocWeight")</label>
                </td>
                <td align="right" style="padding-left:2px;">
                    @*  <label ID="lblTotal" class="labelClass padddingRight tdNoWrap NumericFieldsClass"> @(Model?.Where(x => x.DW_DECISION ==10).Sum(x => x.PP_ACT_ALLOC_QTY ?? 0) ?? 0)</label> *@
                    <label ID="lblTotal" class="labelClass padddingRight tdNoWrap NumericFieldsClass">@(Model?.GroupBy(x => x.PP_CHUUBAN).Sum(g => g.FirstOrDefault()?.PP_ACT_ALLOC_QTY ?? 0) ?? 0)</label>

                </td>
                <td colspan="10" align="right">
                    <label runat="server">@LocalizationServices.GetLocalizedHtmlString("lbl_TotalWeight")</label>
                </td>
                <td align="right" style="padding-left:2px;">
                    @* <label ID="lblTotal" class="labelClass padddingRight tdNoWrap NumericFieldsClass"> @(Model?.Where(x => x.DW_DECISION == 10).Sum(x => x.DW_FINISHED_QTY ?? 0) ?? 0)</label> *@

                    <label ID="lblTotal" class="labelClass padddingRight tdNoWrap NumericFieldsClass">
                        @(Model?.Where(x => x.DW_DECISION == 10 ||
                                                x.DW_DECISION == 30 ||
                                                x.DW_DECISION == 40)
                                                .Sum(x => x.DW_FINISHED_QTY ?? 0) ?? 0)
                    </label>

                </td>
                <td colspan="7"></td>
            </tr>
        </tfoot>
    </table>

</div>