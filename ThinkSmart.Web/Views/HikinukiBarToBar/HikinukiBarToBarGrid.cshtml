@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<HikinukiBarToBarDetails>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;
}
<style>
    /* Freeze first column */
    .sticky-col {
        position: sticky;
        left: 0;
        background: #fff;
        z-index: 2;
    }

    /* Keep header above */
    #tblData th.sticky-col {
        z-index: 3;
    }
</style>
<link href="~/css/Common_Styles.css" rel="stylesheet" asp-append-version="true" />
<div>

    @*Fixed Grid view (scroll bar Issue) :  Pradeep 2020/10/21*@
    <table class="freez GridLines GridColumnLeftPadding" cellpadding="0" cellspacing="0" border="1" id="grdvProductList">

        <thead>
            <tr class="GridHeader GridViewScrollHeader freez GridHeaderPadding">
                <th class="headerPadding labelClass thGrid sticky-header">@LocalizationServices.GetLocalizedHtmlString("")</th>

                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_TabaNo")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Machine_L")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_OperationDay")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</th>

                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_ProductDim")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdShape")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_ProductLength")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lblMaterialNameMaker")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_MaterialDimD")</th>

                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Charge")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_MetallicLabel")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Operator")</th>
                <th class="headerPadding labelClass thGrid">@LocalizationServices.GetLocalizedHtmlString("lbl_Decision")</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var item in Model)
                {
                    <tr data-lblDrawingCD="@item.DRAWING_CD">
                        <td class="sticky-col1">
                            <input id="btnLnkEdit" type="button" value='@LocalizationServices.GetLocalizedHtmlString("lbl_EditDelete")' class="_functionButtons"
                                   onclick="getHikinukiDetailsByDrawingCD($(this))" />
                        </td>
                        <td class="labelClass GridCenter">@item.PP_CHUUBAN_GYOUBAN</td>
                        <td class="labelClass GridCenter">@item.DW_TABA_NO_</td>
                        <td class="labelClass GridLeft">@item.DW_MACHINE_NAME</td>
                        <td class="labelClass GridCenter">@item.DW_END_DATE_STRING</td>
                        <td class="labelClass GridLeft">@item.PP_CUSTOMER_NAME</td>
                        <td class="labelClass GridLeft">@item.PP_PROD_NAME_CUST</td>
                        <td class="labelClass GridRight">@item.PP_PROD_DIM_D_SHAPE_STRING</td>
                        <td class="labelClass GridLeft">@item.PP_PROD_SHAPE</td>
                        <td class="labelClass GridRight">@item.PP_PROD_LENGTH</td>
                        <td class="labelClass GridLeft">@item.PP_PROD_NAME_INT</td>
                        <td class="labelClass GridRight">@item.PP_MATL_DIM_D_SHAPE</td>
                        <td class="labelClass GridLeft">@item.PP_CHARGE</td>
                        <td class="labelClass GridLeft">@item.DW_METALLIC_PLATE_CODE</td>
                        <td class="labelClass GridRight">@item.PP_NO_OF_UNITS_DECODE</td>
                        <td class="labelClass GridRight">@item.DW_FINISHED_QTY</td>
                        <td class="labelClass GridLeft">@item.DW_START_OPERATOR_NAME</td>
                        <td class="labelClass GridCenter">@item.DW_DECISION_STRING</td>
                    </tr>
                }
            }
            else
            {
                <tr style="height:20px;">
                    <td colspan="18" align="left" style="padding-left:5px;"><label ID="lbldatanotavailable" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_NoRecordFound_L")</label></td>
                </tr>
            }
        </tbody>
    </table>



</div>