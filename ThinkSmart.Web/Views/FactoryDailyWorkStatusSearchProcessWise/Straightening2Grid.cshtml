                    <td rowspan="2" class="labelClass tdNoWrap centerAlign">@item.ALL_TABA_NO</td>
                    <td class="labelClass padddingLeft tdNoWrap CharactFieldsClass" rowspan="2">@Html.Raw(@item.STR_REMARKS.Replace("<br>", "<br/>"))</td>
                    <td class="labelClass tdNoWrap centerAlign" rowspan="2">@item.STR_DECISION_STRING</td>
                    <td rowspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.NEXT_PROCESS_NAME</td>


                </tr>
                <tr class="GridNormalRow">

                    <td colspan="2" class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.STR_MACHINE_NAME</td>
                    <td  class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_EMPLOYEE_NAME</td>
                    <td class="labelClass tdNoWrap centerAlign">@item.PP_PROD_SPEC_NO</td>
                    @*<td class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.PP_HT_CONDITION</td>*@
                    <td class="labelClass padddingLeft tdNoWrap CharactFieldsClass">@item.STR_METALLIC_PLATE_CODE</td>
                    <td class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.PP_ACT_ALLOC_QTY</td>
                    <td class="labelClass tdNoWrap lblXY">Y</td>
                    <td class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.STR_DIM_AFTER_Y_1_STRING</td>
                    <td class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.STR_DIM_AFTER_Y_2_STRING</td>
                    <td class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.STR_DIM_AFTER_Y_3_STRING</td>
                    <td class="labelClass padddingRight tdNoWrap NumericFieldsClass">@item.STR_QTY</td>
                    <td class="labelClass tdNoWrap centerAlign">@item.STR_BEND_STATUS_DECODE</td>

                </tr>
            }
        }
        else
        {
            <tr class="GridNormalRow">
                <td class="labelClass padddingLeft padddingRight " rowspan="2" style=" white-space:nowrap">
                    <input type="button" class="btnArrow" style="height:42px;float: right;" />
                </td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td style="width: 95px;" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" ></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap lblMinMax"> X </td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap Proceplanwidth1"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap Proceplanwidth1"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap Proceplanwidth1"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap Proceplanwidth1"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap" rowspan="2"></td>

            </tr>
            <tr class="GridNormalRow">

                <td colspan="2" class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td  class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                @*<td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>*@
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap lblXY">Y</td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>
                <td class="labelClass tdPaddingLeftandRight tdNoWrap"></td>

            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="footerRow" style="position: sticky !important;">
            <td colspan="12" align="right">
                <label runat="server">@LocalizationServices.GetLocalizedHtmlString("lbl_TotalActAllocWeight")</label>
            </td>
            <td align="right" style="padding-left:2px;">
                @* <label class="labelClass padddingRight tdNoWrap NumericFieldsClass" ID="lblTotal"> @(Model?.Where(x => x.STR_DECISION == 10).Sum(x => x.PP_ACT_ALLOC_QTY ?? 0) ?? 0)</label> *@
                <label class="labelClass padddingRight tdNoWrap NumericFieldsClass" ID="lblTotal"> @(Model?.GroupBy(x => x.PP_CHUUBAN).Sum(g => g.FirstOrDefault()?.PP_ACT_ALLOC_QTY ?? 0) ?? 0)</label>

            </td>
            <td colspan="6" align="right">
                <label runat="server">@LocalizationServices.GetLocalizedHtmlString("lbl_TotalWeight")</label>
            </td>
            <td align="right" style="padding-left:2px;">
                @* <label class="labelClass padddingRight tdNoWrap NumericFieldsClass" ID="lblTotal"> @(Model?.Where(x => x.STR_DECISION == 10).Sum(x => x.STR_QTY ?? 0) ?? 0)</label> *@
                <label class="labelClass padddingRight tdNoWrap NumericFieldsClass" ID="lblTotal">
                    @(Model?.Where(x => x.STR_DECISION == 10 ||
                                        x.STR_DECISION == 30 ||
                                        x.STR_DECISION == 40)
                                        .Sum(x => x.STR_QTY ?? 0) ?? 0)
                </label>


            </td>
            <td colspan="7"></td>
        </tr>
    </tfoot>
</table>
