                <th class="headerPadding labelClass"  style="text-align:center;word-break: break-all; width:88px">@LocalizationServices.GetLocalizedHtmlString("lbl_TransferNumber")</th>
                <th class="headerPadding labelClass"  style=" text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</th>
                <th class="headerPadding labelClass"  style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_DimD")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap;width:30px">@LocalizationServices.GetLocalizedHtmlString("lbl_Shape")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_WidthAndOther")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Length")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Charge")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_TabaNo")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")</th>
                <th class="headerPadding labelClass" style="text-align:center;white-space:nowrap">@LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")</th>
                <th wrap="false" class="headerPadding labelClass" style="text-align:center; word-break: break-all; width:135px">@LocalizationServices.GetLocalizedHtmlString("lblNextProcess")</th>
                <th class="headerPadding labelClass" style="text-align:center;word-break: break-all; width:170px">@LocalizationServices.GetLocalizedHtmlString("lbl_CommunicationRemark")</th>
            </tr>
        </thead>
        <tbody>
         

            @for (Int32 i = 1; i <= 20; i++)
                                          {
             @*   @if (Model != null)
                {
                    foreach (var item in Model)
                    {*@
                <tr id="@("tr"+i)">
                   
                    <td class="GridMandatoryTextBox" style="height: 20px;padding-left:0px !important" align="center">
                        <input type="checkbox" ID="@("chkTensouAccepGrid"+i)" TabIndex="10" data-title="chkTensouAccepGrid" data-rowid="@i" />
                    </td>

                    <td class="labelClass MandatoryTD"><input type="text" ID=@("txtTransferCD" + i) class="GridMandatoryTextBox" style="Width:80px;padding-right: -5px" TabIndex="1" maxlength="10" Enabled="false"><span class="text-danger"></span>
                        <input type="hidden" id="@("hdfUnitType"+ i)" value="" />
                        <input type="hidden" id="@("hdfNoOfUnits"+ i)" value="" />
                        <input type="hidden" id="@("hdfTransferNo"+ i)" value="" />
                        <input type="hidden" id="@("hdProcessPlanCD"+ i)" value="" />
                    </td>
                    <td class="labelClass" id=@("lblChuuban" + i) style="background-color:#E2E2E2 !important"></td>
                    <td class="labelClass" id=@("lblCustomer" + i) style="background-color:#E2E2E2 !important"></td>
