@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<WIPTensouDetails>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;
   // int userId = ViewBag.UserId;
}
<div>
    <table id="WIPTensouAcceptance" class="GridLines GridColumnLeftPadding" cellpadding="0" cellspacing="0" border="1" style="width:100%">
        <thead>
            <tr class="GridHeader GridViewScrollHeader freez GridHeaderPadding">
