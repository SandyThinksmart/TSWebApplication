@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<ProcessPlanForSalesProductionStatusDetails>
@inject LocalizationServices LocalizationServices
@{
    Layout = null;
}

<link href="~/css/Common_Styles.css" rel="stylesheet" asp-append-version="true" />
<link href="~/css/salesproductionstatussearch.css" rel="stylesheet" asp-append-version="true" />

<div>
    <table>
        <tr>
            <td style="vertical-align: top">

                        <table class="GridLines GridNormalRows" id="grdvBundlewise">
                            <tr class="thHeaderClass">
                                <th>
                                    <label ID="lblBundleNo" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_bundleno")</label>
                                </th>
                                <th>
                            <label ID="lblBarCount" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_NoOfUnits")</label>
                                </th>
                                <th>
                                    <label ID="lblWeightWithoutKG" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_WeightWithoutKG")</label>
                                </th>
                                <th>
                                    <label ID="lblEC2" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_EC")</label>
                                </th>
                                <th>
                                    <label ID="lblDecision" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_Decision")</label>
                                </th>
                                <th>
                                    <label ID="lblFIDecision" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_FIDecisionProcessStatusSearchForSales_L")</label>
                                </th>
                                <th>
                                    <label ID="lblECNGBars2" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ECNGBars")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo1" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo1")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo2" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo2")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo3" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo3")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo4" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo4")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo5" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo5")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo6" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo6")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo7" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo7")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo8" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo8")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo9" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo9")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo10" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo10")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo11" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo11")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo12" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo12")</label>
                                </th>
                                <th>
                                    <label ID="lblProcessNo13" class="labelClass labelPadding">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessNo13")</label>
                                </th>
                            </tr>
                            <tbody>
                                @if (Model != null && Model.Count > 0)
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr class="GridNormalRow">
                                    <td class="labelClass GridCenter">@item.TABA_NO</td>
                                            <td class="labelClass GridRight">@item.FINISHED_BARS_DECODE</td>
                                            <td class="labelClass GridRight">@item.FINISHED_QTYS</td>
                                    <td class="labelClass GridCenter" style="background-color:@item.EC_COLOR;color:white;">@item.EC_DECISION_STRING</td>
                                            <td class="labelClass GridCenter" style="background-color:@item.PP_COLOR;color:white;">@item.RESULT_DECISION_STRING</td>
                                    <td class="labelClass GridCenter" style="background-color:@item.FI_COLOR;color:white;">@item.FI_DECISION_STRING</td>
                                            <td class="labelClass GridRight">@item.TOTAL_NG_BARS</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_1</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_2</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_3</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_4</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_5</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_6</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_7</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_8</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_9</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_10</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_11</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_12</td>
                                            <td class="labelClass GridLeft">@item.PP_PROCESS_13</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="GridNormalRow">
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                }

                        </table>
                
            </td>
        </tr>
    </table>
</div>

