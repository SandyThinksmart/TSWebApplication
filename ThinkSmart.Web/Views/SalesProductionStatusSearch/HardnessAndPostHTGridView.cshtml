                            <td class="GridRight">@if (!string.IsNullOrEmpty(@item.MAX_LOAD_STRING)){@item.MAX_LOAD_STRING}</td>
                            <td class="GridRight">@if (!string.IsNullOrEmpty(@item.CUTTING_ELONGATION_STRING)){ @item.CUTTING_ELONGATION_STRING }</td>
                            <td class="GridRight">@if (!string.IsNullOrEmpty(@item.FRACTURE_DIM_STRING)){@item.FRACTURE_DIM_STRING}</td>
                                    <td class="GridCenter">@item.STD_HARDNESS_STRING</td>
                                    <td class="GridRight">@item.HARDNESS_MAX</td>
                            <td class="GridRight">@item.HARDNESS_MIN</td> @* item.HARD_MIN_MAX_STRING && item.HARDNESS_PATTERN1 *@
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.D4_AVG_STRING)){@item.D4_AVG_STRING}</td>
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.CENTER_STRING)){@item.CENTER_STRING}</td>
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.D4_1_STRING)){@item.D4_1_STRING}</td>
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.D4_2_STRING)){@item.D4_2_STRING }</td>
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.D4_3_STRING)){@item.D4_3_STRING }</td>
                            <td class="GridRight">@if(!string.IsNullOrEmpty(@item.D4_4_STRING)){@item.D4_4_STRING}</td>
                                   
