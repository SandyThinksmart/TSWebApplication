        </tr>
        <tr class="GridHeader GridViewScrollHeader freezStraighteing2DailyGrid1 GridHeaderPadding gridHeaderBgColor">
            <th align="left" valign="middle" class="tdHeaderClass1 labelClass GridCenter sticky-header" rowspan="2">

            </th>
            <th id="strng2ProcessLocation" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProcessLocation")</th>
            <th id="strng2OperationDay" colspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_OperationDayStartEnd")</th>
            <th id="strng2Customer" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Customer")</th>
            <th id="strng2Chuuban" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_Chuuban")</th>
            <th id="strng2ProdNameCust" rowspan="2" class="headerPadding labelClass tdNoWrap">@LocalizationServices.GetLocalizedHtmlString("lbl_ProdNameCust")</th>

            <th id="strng2Shape" rowspan="2" class=" labelClass lblShape">@LocalizationServices.GetLocalizedHtmlString("lbl_Shape")</th>
