                                <tr>
                                    <td align="center" valign="middle">
                                        <label ID="lblClose" class="labelClass" style="color:White;padding-top:12px">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" valign="middle">
                                        <br />
                                        <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose" class="_functionButtons" OnClientClick="return Confirmation()" TabIndex="10" />
                                    </td>
