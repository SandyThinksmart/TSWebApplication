@using TSWebApplication.Domain.Model
@using TSWebApplication.Domain.Resources
@model List<MatlNameWiseOrderQtyDetails>
@inject LocalizationServices LocalizationServices
@{
    ViewData["Title"] = LocalizationServices.GetLocalizedHtmlString("btn_MaterialWiseSubTotal").Value.Replace("</br>", ""); ;
}
<meta name="google" content="notranslate" />

<style type="text/css">
    .hide {
        display: none;
    }

    .headerPadding {
        padding-left: 10px !important;
        padding-right: 10px !important;
    }

    .fixLengthDataPadding {
        padding-left: 5px !important;
        padding-right: 5px !important;
    }

    .freez > th {
        position: sticky !important;
        background-color: #7291D2;
        border-color: white;
        top: 0.2px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .bottomDiv {
        margin-top: 2px;
        margin-left: 2px;
        border: 1px inset gray;
        width: 485px;
    }

    .freezMatlNameWiseOrderGrid > th {
        position: sticky !important;
        background-color: #4e6cab;
        top: 0.0px;
        height: 20px;
        box-shadow: 0 0 0px 0.5px White;
    }

    .freezMatlNameWiseOrderGrid {
        border-color: white;
    }
</style>

<div id="pnlMatlNameWiseOrderQtyPopUp" style="width: 486px;">
        <table bgcolor="#7291D2" border="0" cellpadding="0" cellspacing="0" id="tblForecastStatusPopUp" class="GridLines" style="width:440px">
        <tr class="freezMatlNameWiseOrderGrid">

                <th class="tdH1" colspan="9" align="center" style="padding:6px">
                <label id="lblOrderQtyInfo" class="labelClass" style="color:white">@LocalizationServices.GetLocalizedHtmlString("lbl_MonthsMatlForecastQtyInTons")</label>

                </th>

            </tr>
        
        <tr >
            <th style="vertical-align: top;">

                <div id="divMatlNameWiseOrderQtyList">
                    @{
                        @await Html.PartialAsync("MatlNameWiseOrderQtyList", Model)
                        ;
                    }
                </div>

            </th>
        </tr>
          
        </table>
    </div>


<div id="" class="bottomDiv">
    <table style="margin:2px;" >
        <tr>
            <td colspan="6" style="width:406px"></td>
            <td >

                <table id="tblRefresh">
                    <tr>
                        <td align="center" valign="middle">
                            <label ID="lblClose" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_RefreshData")</label>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" valign="middle">

                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Recalculate")" ID="btnRefreshData" class="_functionButtons" />
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width:5px"></td>
            <td id="tdBtnClose">
                <table id="tblClose">
                    <tr>
                        <td align="center" valign="middle">
                            <label ID="lblClose" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_CloseWindow")</label>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" valign="middle">
                            
                            <input type="button" value="@LocalizationServices.GetLocalizedHtmlString("btn_Close_L")" ID="btnClose" class="_functionButtons" OnClientClick="return Confirmation()" />
                        </td>
                    </tr>
                </table>
            </td>
            <td style="width:5px"></td>
        </tr>
    </table>
    </div>
    

@section Scripts{

    <link href="~/css/Common.css" rel="stylesheet" />
    <link href="~/css/MatlNamWiseOrderQtyPopUp.css" rel="stylesheet" />
    <link href="~/css/Common_Styles.css" rel="stylesheet" />
    <link href="~/css/masterStyles.css" rel="stylesheet" />
    <script src="~/static/js/MatlNameWiseOrderQtyPopUp.js"></script>

}  