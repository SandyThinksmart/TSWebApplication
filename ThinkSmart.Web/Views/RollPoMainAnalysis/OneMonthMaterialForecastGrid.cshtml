         @if (Model != null && Model.Any())
        {
             int i = 0;
            foreach (var item in Model)
            {
                 i = i + 1;
                <tr class="GridNormalRow">
                    <td class="labelClass padddingLeft padddingRight alignCenter" rowspan="2">
                        <input type="radio" ID=@("selectRow" + i) data-id="@i" class="labelClass" name="radiobtn" />
                    </td>
                    <td style="display:none;">
                        <label type="text" ID="@("matlRollFCCd"+i)" data-id="@i">@item.ROLL_FC_CD</label>
                    </td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.CUSTOMER </td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.MAKER_DETAILS</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.MATL_NAME_MAKER</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.MATL_KUBUN_NAME</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.DIM_D</td>
                    <td class="labelClass padddingLeft padddingRight alignCenter">@item.SHAPE</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.DIM_W</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.DIM_OTHER</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.MATERIAL_LENGTH</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.FC_QTY_R1</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.FC_QTY_R2</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.FC_QTY_R3</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.FC_QTY_R4</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.REQD_MATL_QTY_1MONTH</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.REQD_MATL_QTY_2MONTH</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.REQD_MATL_QTY_3MONTH</td>
                    <td class="labelClass NumericFieldsClass padddingRight">@item.REQD_MATL_QTY_4MONTH</td>
                    <td rowspan="2" class="labelClass padddingLeft padddingRight" style="text-align:center;background-color:white">
                       @* <input type="checkbox" id="@("chkMatlSalesFcDoneDate"+i)" style="position: relative;width: 15px;"/>*@
                        @if (item.SALES_FC_DONE_DATE.HasValue)
                                            {
                                                <input type="checkbox" id="@("chkMatlSalesFcDoneDate"+i)" checked/>
                                            }
                                            
                                            else
                                            {
                                                <input type="checkbox" id="@("chkMatlSalesFcDoneDate"+i)"/>
                                            }
                    </td>

                    <td rowspan="2" class="labelClass padddingLeft">
                       
                        @* <select ID="ddlMaterialReply" TabIndex="25" class="DropdownListClass dropListClass"
                                style="height: 38px;width:300px;margin-left:-2px;">
                        </select> *@
                         <input type="text" id="@("txtMaterialReplyMatl"+i)"  class="labelClass GridTextBox padddingLeft tdNoWrap CharactFieldsClass" style="height:36px; width:236px;" value="@item.REPLY_FROM_MATL_DEPT"/>
                       
                    </td>

                </tr>
                <tr class="GridNormalRow lastRowBorderColor" >
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.INCHARGE</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.MAKER_NAME</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.INTERNAL_NAME</td>
                    <td class="labelClass CharactFieldsClass padddingLeft">@item.MATL_SPECIAL_KUBUN_NAME</td>
                    <td colspan="4" class="labelClass CharactFieldsClass padddingLeft">@item.CONDITION_DESCRIPTION</td>
                    <td class="labelClass padddingLeft padddingRight alignCenter"></td>
                    <td colspan="8" class="labelClass CharactFieldsClass padddingLeft">
                        @item.MSG_TO_MATL_DEPT
                    </td>                   
                </tr>

            }
             <tr class="GridNormalRow " style="background-color:#ffffae">

                <td class="labelClass NumericFieldsClass"  colspan="10">
            <label class="labelClass">
                @LocalizationServices.GetLocalizedHtmlString("lbl_Sum_L")
            </label>
        </td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass ">  @Model.Sum(x => x.FC_QTY_R1 ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass "> @Model.Sum(x => x.FC_QTY_R2 ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass ">  @Model.Sum(x => x.FC_QTY_R3 ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass "> @Model.Sum(x => x.FC_QTY_R4 ?? 0).ToString("0.0")</td>
                
                 <td class="labelClass padddingRight tdNoWrap NumericFieldsClass ">  @Model.Sum(x => x.REQD_MATL_QTY_1MONTH ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass "> @Model.Sum(x => x.REQD_MATL_QTY_2MONTH ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass ">  @Model.Sum(x => x.REQD_MATL_QTY_3MONTH ?? 0).ToString("0.0")</td>
                <td class="labelClass padddingRight tdNoWrap NumericFieldsClass "> @Model.Sum(x => x.REQD_MATL_QTY_4MONTH ?? 0).ToString("0.0")</td>
                <td></td>
                <td></td>
            </tr>
        } 
       else
        {
            <tr style="text-align:left"><td colspan="25"><label ID="lbldatanotavailable" class="labelClass">@LocalizationServices.GetLocalizedHtmlString("lbl_NoRecordFound_L")</label></td></tr>
        }
    </table>

